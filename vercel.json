{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "redirects": [
        {
            "source": "/",
            "has": [
                {
                    "type": "header",
                    "key": "Accept-Language",
                    "value": "^[zZ][hH](?:-|,|;|$).*"
                }
            ],
            "destination": "/zh-TW/",
            "permanent": false
        },
        {
            "source": "/",
            "destination": "/en/",
            "permanent": false
        }
    ]
}
