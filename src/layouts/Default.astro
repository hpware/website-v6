---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_NAME } from "../consts";
import {
    createTranslator,
    defaultLocale,
    type Locale,
} from "../i18n";

interface Props {
    title?: string;
    description?: string;
    locale?: Locale;
    translationPath?: string;
}
const {
    locale = defaultLocale,
    translationPath = Astro.url.pathname,
} = Astro.props;
const T = createTranslator(locale);
const desc = Astro.props.description ?? T("歡迎來到我的網站！");
---

<!doctype html>
<html lang={locale}>
    <head>
        <BaseHead
            title={`${Astro.props.title === undefined ? "" : `${Astro.props.title} | `}${SITE_NAME}`}
            description={desc.length > 160 ? desc.slice(0, 157) + "..." : desc}
            locale={locale}
            translationPath={translationPath}
        />
    </head>
    <body>
        <Header locale={locale} translationPath={translationPath} />
        <main class="min-h-screen px-4 pt-24 md:pt-8">
            <slot />
        </main>
        <Footer locale={locale} />
    </body>
</html>
