---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_NAME } from "../consts";
import { ClientRouter } from "astro:transitions";
import {
    createTranslator,
    defaultLocale,
    type Locale,
} from "../i18n";

interface Props {
    title?: string;
    description?: string;
    locale?: Locale;
    translationPath?: string;
}
const {
    locale = defaultLocale,
    translationPath = Astro.url.pathname,
} = Astro.props;
const T = createTranslator(locale);
const desc = Astro.props.description ?? T("歡迎來到我的網站！");
---

<!doctype html>
<html lang={locale}>
    <head>
        <BaseHead
            title={`${Astro.props.title === undefined ? "" : `${Astro.props.title} | `}${SITE_NAME}`}
            description={desc.length > 160 ? desc.slice(0, 157) + "..." : desc}
            locale={locale}
            translationPath={translationPath}
        />
        {/* Client-side routing through same-document view transitions, so the
            page-to-page animation also plays in Firefox (which supports
            same-document, but not cross-document, view transitions). */}
        <ClientRouter />
    </head>
    <body>
        <Header locale={locale} translationPath={translationPath} />
        <main class="min-h-screen px-4 pt-20 sm:px-6">
            <slot />
        </main>
        <Footer locale={locale} />
        <slot name="page-end" />
    </body>
</html>
