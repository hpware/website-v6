---
// Shared page for a blog post or food review: header, hero image, body,
// table of contents (wide screens), and links to the neighbouring posts.
// Food reviews pass their own info box in the "meta" slot instead of the date line.
import type { ImageMetadata, MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import {
    ArrowLeft,
    ArrowRight,
    Calendar,
    CalendarSync,
    ChevronLeft,
} from "@lucide/astro";
import ArticleTranslation from "./ArticleTranslation.astro";
import FormattedDate from "./FormattedDate.astro";
import Link from "./Link.astro";
import Prose from "./Prose.astro";
import Layout from "../layouts/Default.astro";
import { createTranslator, type Locale } from "../i18n";
import type { TranslatableCollection } from "../lib/translations";

interface Neighbour {
    title: string;
    href: string;
}

interface Props {
    locale: Locale;
    collection: TranslatableCollection;
    slug: string;
    markdown: string | undefined;
    translationPath: string;
    backHref: string;
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    heroImage?: ImageMetadata;
    headings: MarkdownHeading[];
    /** The older post. */
    previous?: Neighbour;
    /** The newer post. */
    next?: Neighbour;
}

const {
    locale,
    collection,
    slug,
    markdown,
    translationPath,
    backHref,
    title,
    description,
    pubDate,
    updatedDate,
    heroImage,
    headings,
    previous,
    next,
} = Astro.props;
const T = createTranslator(locale);
const toc = headings.filter((heading) => heading.depth <= 3);
const showToc = toc.length >= 2;
---

<Layout
    locale={locale}
    translationPath={translationPath}
    title={title}
    description={description}
>
    <div
        class="mx-auto max-w-3xl xl:grid xl:max-w-none xl:grid-cols-[1fr_minmax(0,48rem)_1fr] xl:gap-12"
    >
        <article class="min-w-0 pb-3 xl:col-start-2">
            <header>
                <Link href={backHref} class="text-sm text-muted-foreground">
                    <ChevronLeft class="h-5 w-5" />{T("返回")}
                </Link>
                <h1
                    data-article-title
                    class="mt-4 text-4xl leading-tight font-bold"
                >
                    {title}
                </h1>
                {
                    description && (
                        <p class="mt-3 text-lg text-muted-foreground">
                            {description}
                        </p>
                    )
                }
                {
                    Astro.slots.has("meta") ? (
                        <slot name="meta" />
                    ) : (
                        <div class="mt-4 flex flex-row flex-wrap gap-4 text-sm text-muted-foreground">
                            <div class="flex flex-row items-center gap-1.5">
                                <Calendar class="h-4 w-4" />
                                <FormattedDate date={pubDate} locale={locale} />
                            </div>
                            {updatedDate && (
                                <div class="flex flex-row items-center gap-1.5">
                                    <CalendarSync class="h-4 w-4" />
                                    <FormattedDate
                                        date={updatedDate}
                                        locale={locale}
                                    />
                                </div>
                            )}
                        </div>
                    )
                }
            </header>

            {
                heroImage && (
                    <Image
                        width={1020}
                        height={510}
                        src={heroImage}
                        alt=""
                        class="mt-8 w-full rounded-xl"
                    />
                )
            }

            <hr class="my-8 border-t border-border" />

            <ArticleTranslation
                locale={locale}
                collection={collection}
                slug={slug}
                markdown={markdown}
            />
            <Prose data-article-body>
                <slot />
            </Prose>

            {
                (previous || next) && (
                    <nav class="mt-16 grid gap-3 sm:grid-cols-2">
                        {previous ? (
                            <a
                                href={previous.href}
                                class="rounded-lg border border-foreground/15 px-5 py-4 transition-colors duration-200 hover:bg-foreground/5"
                            >
                                <span class="flex items-center gap-1 text-sm text-muted-foreground">
                                    <ArrowLeft class="h-4 w-4" />
                                    {T("上一篇")}
                                </span>
                                <span class="mt-1 block">{previous.title}</span>
                            </a>
                        ) : (
                            <span class="hidden sm:block" />
                        )}
                        {next && (
                            <a
                                href={next.href}
                                class="rounded-lg border border-foreground/15 px-5 py-4 text-right transition-colors duration-200 hover:bg-foreground/5"
                            >
                                <span class="flex items-center justify-end gap-1 text-sm text-muted-foreground">
                                    {T("下一篇")}
                                    <ArrowRight class="h-4 w-4" />
                                </span>
                                <span class="mt-1 block">{next.title}</span>
                            </a>
                        )}
                    </nav>
                )
            }
        </article>

        {
            showToc && (
                <aside class="hidden xl:block">
                    <nav
                        class="sticky top-28 max-w-60 text-sm"
                        aria-labelledby="toc-heading"
                    >
                        <p id="toc-heading" class="mb-3 font-bold">
                            {T("目錄")}
                        </p>
                        <ul class="flex flex-col border-l border-border">
                            {toc.map((heading) => (
                                <li>
                                    <a
                                        href={`#${heading.slug}`}
                                        data-toc-link
                                        class:list={[
                                            "-ml-px block border-l border-transparent py-1 pr-2 text-muted-foreground transition-colors hover:text-foreground aria-[current=true]:border-primary aria-[current=true]:text-foreground",
                                            heading.depth === 3 ? "pl-7" : "pl-4",
                                        ]}
                                    >
                                        {heading.text}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                </aside>
            )
        }
    </div>
</Layout>

<script>
    // Highlight the table of contents entry for the section being read.
    const links = [
        ...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    ];
    const linkFor = new Map(
        links.map((link) => [decodeURIComponent(link.hash.slice(1)), link]),
    );

    const observer = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                links.forEach((link) => link.removeAttribute("aria-current"));
                linkFor.get(entry.target.id)?.setAttribute("aria-current", "true");
            }
        },
        { rootMargin: "-96px 0px -70% 0px" },
    );

    for (const id of linkFor.keys()) {
        const heading = document.getElementById(id);
        if (heading) observer.observe(heading);
    }
</script>
