---
const today = new Date();
import { SITE_NAME } from "../consts";
import Link from "./Link.astro";
import Socials from "./Socials.tsx";
import {
    defaultLocale,
    localizedPath,
    translations,
    type Locale,
} from "../i18n";

interface Props {
    locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = translations[locale].footer;
const linkColumns = [
    [
        { name: copy.home, href: localizedPath(locale, "/") },
        { name: copy.blog, href: localizedPath(locale, "/blog/") },
        {
            name: copy.contributions,
            href: localizedPath(locale, "/contributions/"),
        },
        { name: copy.about, href: "/about" },
    ],
    [
        { name: copy.v5Website, href: "https://v5.yuanhau.com" },
        { name: copy.v4Website, href: "https://v4-1-3.yuanhau.com" },
        { name: copy.oldBlog, href: "https://4-1-2.yuanhau.com/posts/" },
        { name: "wp.yuanhau.com", href: "https://wp.yuanhau.com" },
        {
            name: copy.sourceCode,
            href: "https://github.com/hpware/website-v6",
        },
        { name: copy.email, href: "mailto:hw+yhv6@yuanhau.com" },
        { name: copy.status, href: "https://status.yhw.tw/" },
        { name: copy.statusHl, href: "https://yhw.tw/status" },
    ],
];
---

<footer class="relative inset-x-0 bottom-0 mt-16">
    <hr
        class="m-auto w-[calc(100%-30px)] flex-wrap bg-black/50 text-center dark:bg-white/50"
    />

    <div
        class="mt-4 mb-2 flex flex-row flex-wrap justify-center gap-2 p-1 align-middle"
    >
        <section
            class="m-2 flex w-full flex-col p-2 md:w-[calc(50%-30px)] md:pl-12"
        >
            <img
                src="/images/profile.jpg"
                width="60"
                height="60"
                alt={copy.profileAlt}
                draggable="false"
                class="rounded"
            />
            <span class="text-xl">Howard</span>
            <span class="text-sm">
                <i>
                    {copy.quote}
                </i>
            </span>
            <Socials />
        </section>

        <section class="m-2 flex w-full flex-col p-2 md:w-[calc(50%-30px)]">
            <h3 class="m-2 text-xl"><i>{copy.links}</i></h3>
            <div class="ml-4 flex flex-col md:flex-row">
                {
                    linkColumns.map((column, index) => (
                        <div
                            class={`flex flex-col gap-2 ${index === 1 ? "mt-4 md:mt-0 md:ml-12" : "mr-12"}`}
                        >
                            {column.map((item) => (
                                <Link
                                    href={item.href}
                                    class="flex flex-row items-center transition-all duration-300 hover:text-gray-600/50 dark:hover:text-gray-300/50"
                                >
                                    {item.name}
                                </Link>
                            ))}
                        </div>
                    ))
                }
            </div>
        </section>
    </div>

    <div class="flex flex-col">
        <div class="p-4 text-center text-gray-500 md:text-right">
            &copy; {today.getFullYear()}
            {SITE_NAME} || {copy.licensePrefix} <Link
                href="https://creativecommons.org/licenses/by-sa/4.0/"
                >CC BY-SA 4.0</Link
            > {locale === "en" ? "license." : "授權條款釋出。"} v6 ß
        </div>
    </div>
</footer>
