---
import { Image } from "astro:assets";
import { Languages } from "@lucide/astro";
import ProfileImage from "../assets/pfp.jpg";
import { SITE_NAME } from "../consts";
import Link from "./Link.astro";
import Socials from "./Socials.tsx";
import {
    createTranslator,
    defaultLocale,
    localizedPath,
    type Locale,
} from "../i18n";

const today = new Date();

interface Props {
    locale?: Locale;
    translationPath?: string;
}

const { locale = defaultLocale, translationPath = Astro.url.pathname } =
    Astro.props;
const T = createTranslator(locale);
const otherLocale: Locale = locale === "en" ? "zh-TW" : "en";
const languageLabel = locale === "en" ? "繁體中文" : "English";
const languageUrl = localizedPath(otherLocale, translationPath);
const linkColumns = [
    {
        title: T("主要頁面"),
        links: [
            { name: T("首頁"), href: localizedPath(locale, "/") },
            { name: T("部落格"), href: localizedPath(locale, "/blog/") },
            { name: T("美食"), href: localizedPath(locale, "/food/") },
            {
                name: T("貢獻"),
                href: localizedPath(locale, "/contributions/"),
            },
        ],
    },
    {
        title: T("連結"),
        links: [
            { name: T("v5 網站"), href: "https://v5.yuanhau.com" },
            { name: T("v4.1.3 網站"), href: "https://v4-1-3.yuanhau.com" },
            {
                name: T("v4.1.2 舊版部落格"),
                href: "https://4-1-2.yuanhau.com/posts/",
            },
            { name: "wp.yuanhau.com", href: "https://wp.yuanhau.com" },
            {
                name: T("網站原始碼"),
                href: "https://github.com/hpware/website-v6",
            },
            { name: T("電子郵件"), href: "mailto:hw+yhv6@yuanhau.com" },
            { name: T("服務狀態"), href: "https://status.yhw.tw/" },
            { name: T("服務狀態（HL）"), href: "https://yhw.tw/status" },
        ],
    },
];
---

<footer class="mt-24 border-t border-border bg-card">
    <div
        class="mx-auto grid max-w-6xl gap-12 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]"
    >
        <section class="flex flex-col">
            <div class="flex items-center gap-3">
                <Image
                    src={ProfileImage}
                    width={48}
                    height={48}
                    densities={[1, 2]}
                    format="webp"
                    quality="mid"
                    alt={T("Howard 的大頭貼")}
                    draggable="false"
                    loading="lazy"
                    decoding="async"
                    class="size-12 rounded-md object-cover"
                />
                <span class="display-wide text-xl">Howard</span>
            </div>
            <p class="mt-4 max-w-sm text-sm leading-6 text-muted-foreground">
                {T(
                    "Take risks in life. Your great-great-great-grandchildren won't remember you, so why not try, take a few risks, and learn even more? ",
                )}
            </p>
            <Socials />
        </section>

        {
            linkColumns.map((column) => (
                <section>
                    <h2 class="tape tape-white">{column.title}</h2>
                    <ul class="mt-4 flex flex-col gap-2.5 text-sm">
                        {column.links.map((item) => (
                            <li>
                                <Link
                                    href={item.href}
                                    class="text-muted-foreground transition-colors hover:text-foreground"
                                >
                                    {item.name}
                                </Link>
                            </li>
                        ))}
                    </ul>
                </section>
            ))
        }
    </div>

    <div class="border-t border-border">
        <div
            class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-5 font-mono text-[0.7rem] text-muted-foreground sm:px-6 md:flex-row md:items-center md:justify-between"
        >
            <p>
                &copy; {today.getFullYear()}
                {SITE_NAME} · {T("此網站採用")}{" "}
                <Link
                    href="https://creativecommons.org/licenses/by-sa/4.0/"
                    class="text-foreground"
                >
                    CC BY-SA 4.0
                </Link>{" "}
                {T("授權條款釋出。")} · v6
            </p>
            <Link
                id="language-switcher"
                href={`${languageUrl}#language-switcher`}
                lang={otherLocale}
                hreflang={otherLocale}
                aria-label={`${T("語言")}: ${languageLabel}`}
                class="w-fit text-foreground"
            >
                <Languages aria-hidden="true" class="mr-2 size-3.5" />
                {languageLabel}
            </Link>
        </div>
    </div>
</footer>

<style is:global>
    html:has(#language-switcher:target) {
        scroll-behavior: auto;
    }
</style>
