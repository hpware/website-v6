---
import { Image } from "astro:assets";
import ProfileImage from "../assets/pfp.jpg";
import { SITE_NAME } from "../consts";
import Link from "./Link.astro";
import Socials from "./Socials.tsx";
import {
    createTranslator,
    defaultLocale,
    localizedPath,
    type Locale,
} from "../i18n";

const today = new Date();

interface Props {
    locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const T = createTranslator(locale);
const linkColumns = [
    {
        title: T("頁面"),
        links: [
        { name: T("首頁"), href: localizedPath(locale, "/") },
        { name: T("部落格"), href: localizedPath(locale, "/blog/") },
        { name: T("美食"), href: localizedPath(locale, "/food/") },
        { name: T("圖片包"), href: localizedPath(locale, "/photos/") },
        {
            name: T("貢獻"),
            href: localizedPath(locale, "/contributions/"),
        },
        {
            name: T("AI 使用量"),
            href: localizedPath(locale, "/tokens/"),
        },
        {
            name: T("Slop 帳號清單"),
            href: localizedPath(locale, "/slopblock/"),
        },
    ],
},
{
    title: T("連結"),
    links: [
        { name: T("v5 網站"), href: "https://v5.yuanhau.com" },
        { name: T("v4.1.3 網站"), href: "https://v4-1-3.yuanhau.com" },
        {
            name: T("v4.1.2 舊版部落格"),
            href: "https://4-1-2.yuanhau.com/posts/",
        },
        { name: "wp.yuanhau.com", href: "https://wp.yuanhau.com" },
        {
            name: T("網站原始碼"),
            href: "https://github.com/hpware/website-v6",
        },
        { name: T("電子郵件"), href: "mailto:hw+yhv6@yuanhau.com" },
        { name: T("服務狀態"), href: "https://status.yhw.tw/" },
        { name: T("服務狀態（HL）"), href: "https://yhw.tw/status" },
        ],
    },
];
---

<footer class="mt-24 border-t border-foreground/10 px-4 sm:px-6">
    <div class="mx-auto grid max-w-4xl gap-12 py-12 md:grid-cols-[3fr_2fr_3fr]">
        <section class="flex flex-col gap-3">
            <div class="flex items-center gap-3">
                <Image
                    src={ProfileImage}
                    width={44}
                    height={44}
                    densities={[1, 2]}
                    format="webp"
                    quality="mid"
                    alt={T("Howard 的大頭貼")}
                    draggable="false"
                    loading="lazy"
                    decoding="async"
                    class="size-11 rounded-full"
                />
                <span class="text-xl font-bold">Howard</span>
            </div>
            <p class="max-w-sm text-sm leading-6 text-muted-foreground italic">
                {T(
                    "Take risks in life. Your great-great-great-grandchildren won't remember you, so why not try, take a few risks, and learn even more? ",
                )}
            </p>
            <div class="-ml-2 -mt-2"><Socials /></div>
        </section>

        {linkColumns.map((column) => (
            <nav aria-label={column.title}>
                <h2 class="mb-4 text-sm font-bold text-muted-foreground">
                    {column.title}
                </h2>
                <ul class="flex flex-col gap-2 text-sm">
                    {column.links.map((item) => (
                        <li>
                            <Link href={item.href}>{item.name}</Link>
                        </li>
                    ))}
                </ul>
            </nav>
        ))}
    </div>

    <div class="-mx-4 border-t border-foreground/10 px-4 sm:-mx-6 sm:px-6">
        <div class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-1 py-5 text-xs text-muted-foreground">
            &copy; {today.getFullYear()} {SITE_NAME}
            <span class="mx-1 select-none">·</span>
            {T("此網站採用")}
            <Link href="https://creativecommons.org/licenses/by-sa/4.0/">
                CC BY-SA 4.0
            </Link>
            {T("授權條款釋出。")}
            <span class="mx-1 select-none">·</span>
            v6.1 beta
        </div>
    </div>
</footer>
