---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE_NAME } from "../consts";
import {
    createTranslator,
    defaultLocale,
    localizedPath,
    type Locale,
} from "../i18n";
import {
    FileTextIcon,
    HandHelping,
    HouseIcon,
    Images,
    Languages,
    MenuIcon,
    Utensils,
    XIcon,
} from "@lucide/astro";

interface Props {
    locale?: Locale;
    translationPath?: string;
}

const { locale = defaultLocale, translationPath = Astro.url.pathname } =
    Astro.props;
const T = createTranslator(locale);
const tabs = [
    { name: T("首頁"), icon: HouseIcon, url: localizedPath(locale, "/") },
    {
        name: T("部落格"),
        icon: FileTextIcon,
        url: localizedPath(locale, "/blog/"),
    },
    { name: T("美食"), icon: Utensils, url: localizedPath(locale, "/food/") },
    { name: T("圖片包"), icon: Images, url: localizedPath(locale, "/photos/") },
    {
        name: T("貢獻"),
        icon: HandHelping,
        url: localizedPath(locale, "/contributions/"),
    },
];
// The tab for the current section ("/" only matches the homepage itself).
const currentPath = localizedPath(locale, translationPath);
const isCurrent = (url: string) =>
    url === localizedPath(locale, "/")
        ? currentPath === url
        : currentPath.startsWith(url);
const otherLocale: Locale = locale === "en" ? "zh-TW" : "en";
const languageLabel = locale === "en" ? "繁體中文" : "English";
const languageUrl = localizedPath(otherLocale, translationPath);
---

<header>
    <div class="pointer-events-none fixed inset-x-0 top-0 z-50 *:pointer-events-auto">
        <nav
            data-navbar
            class="mx-auto flex w-full max-w-[59rem] items-center justify-between rounded-2xl border border-transparent px-4 py-2 backdrop-blur-lg transition-all duration-300 sm:px-6 data-[scrolled]:mt-3 data-[scrolled]:w-[calc(100%-1.5rem)] data-[scrolled]:border-foreground/10 data-[scrolled]:bg-background/75 data-[scrolled]:py-1 data-[scrolled]:shadow-lg"
        >
            <a
                href={localizedPath(locale, "/")}
                class="flex h-11 items-center text-xl font-bold whitespace-nowrap"
            >
                {SITE_NAME}
            </a>

            <div class="-mr-3 hidden items-center gap-4 md:flex">
                {tabs.map((tab) => (
                    <a
                        href={tab.url}
                        aria-current={isCurrent(tab.url) ? "page" : undefined}
                        class="group flex h-11 items-center text-foreground/65 transition-colors duration-200 hover:text-foreground aria-[current=page]:text-foreground"
                    >
                        <span class="flex flex-row items-center gap-1.5">
                            <tab.icon
                                class="size-5 shrink-0"
                                aria-hidden="true"
                            />
                            <span class="relative leading-none after:absolute after:left-0 after:-bottom-1.5 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-current after:content-[''] after:transition-transform after:duration-300 after:ease-out group-hover:after:scale-x-100 group-focus-visible:after:scale-x-100">
                                {tab.name}
                            </span>
                        </span>
                    </a>
                ))}
                <a
                    href={languageUrl}
                    lang={otherLocale}
                    hreflang={otherLocale}
                    aria-label={`${T("語言")}: ${languageLabel}`}
                    title={languageLabel}
                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg transition-all duration-200 hover:bg-foreground/10"
                >
                    <Languages class="size-5" aria-hidden="true" />
                </a>
                <ThemeToggle locale={locale} />
            </div>

            <div class="-mr-3 flex items-center md:hidden">
                <button
                    type="button"
                    data-menu-toggle
                    aria-label={T("選單")}
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                    class="group relative flex h-11 w-11 items-center justify-center rounded-lg transition-colors duration-200 hover:bg-foreground/10"
                >
                    <MenuIcon
                        class="size-5 transition-[rotate,scale,opacity] duration-200 group-aria-expanded:scale-50 group-aria-expanded:rotate-90 group-aria-expanded:opacity-0"
                        aria-hidden="true"
                    />
                    <XIcon
                        class="absolute size-5 scale-50 -rotate-90 opacity-0 transition-[rotate,scale,opacity] duration-200 group-aria-expanded:scale-100 group-aria-expanded:rotate-0 group-aria-expanded:opacity-100"
                        aria-hidden="true"
                    />
                </button>
            </div>
        </nav>

        <div
            id="mobile-menu"
            data-mobile-menu
            inert
            class="invisible mx-3 mt-2 flex origin-top -translate-y-2 scale-95 flex-col overflow-hidden rounded-2xl border border-foreground/10 bg-background/90 p-2 opacity-0 shadow-lg backdrop-blur-lg transition-[opacity,translate,scale,visibility] duration-200 ease-out data-open:visible data-open:translate-y-0 data-open:scale-100 data-open:opacity-100 motion-reduce:transition-none md:hidden"
        >
            {tabs.map((tab) => (
                <a
                    href={tab.url}
                    aria-current={isCurrent(tab.url) ? "page" : undefined}
                    class="flex flex-row items-center gap-3 rounded-xl p-3 transition-colors duration-200 hover:bg-foreground/10 aria-[current=page]:bg-foreground/10"
                >
                    <tab.icon class="size-5 shrink-0" aria-hidden="true" />
                    <span>{tab.name}</span>
                </a>
            ))}
            <div class="mx-3 my-1 border-t border-foreground/10"></div>
            <div class="flex flex-row items-center justify-between p-1">
                <a
                    href={languageUrl}
                    lang={otherLocale}
                    hreflang={otherLocale}
                    class="flex flex-row items-center gap-3 rounded-xl p-2 transition-all duration-200 hover:bg-foreground/10"
                >
                    <Languages aria-hidden="true" class="size-5 shrink-0" />
                    <span>{languageLabel}</span>
                </a>
                <ThemeToggle locale={locale} />
            </div>
        </div>
    </div>
</header>

<script>
    const navbar = document.querySelector("[data-navbar]");
    const handleScroll = () => {
        navbar?.toggleAttribute("data-scrolled", window.scrollY > 10);
    };
    handleScroll();
    window.addEventListener("scroll", handleScroll, { passive: true });

    // Mobile menu: the toggle, Escape, a click outside, or picking a link closes it.
    const menuToggle = document.querySelector("[data-menu-toggle]");
    const mobileMenu = document.querySelector("[data-mobile-menu]");
    const setMenuOpen = (open: boolean) => {
        if (!(mobileMenu instanceof HTMLElement)) return;
        mobileMenu.toggleAttribute("data-open", open);
        mobileMenu.inert = !open;
        menuToggle?.setAttribute("aria-expanded", String(open));
    };
    menuToggle?.addEventListener("click", () =>
        setMenuOpen(!mobileMenu?.hasAttribute("data-open")),
    );
    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenuOpen(false);
    });
    document.addEventListener("click", (event) => {
        const target = event.target as Node;
        if (menuToggle?.contains(target)) return;
        if (mobileMenu?.contains(target) && !(target as Element).closest("a")) return;
        setMenuOpen(false);
    });
</script>
