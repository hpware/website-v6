---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE_NAME } from "../consts";
import {
    createTranslator,
    defaultLocale,
    localizedPath,
    type Locale,
} from "../i18n";
import { Languages, MenuIcon } from "@lucide/astro";

interface Props {
    locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const T = createTranslator(locale);
const home = localizedPath(locale, "/");
const tabs = [
    { name: T("首頁"), url: home },
    { name: T("部落格"), url: localizedPath(locale, "/blog/") },
    { name: T("美食"), url: localizedPath(locale, "/food/") },
    { name: T("圖片包"), url: localizedPath(locale, "/photos/") },
    { name: T("貢獻"), url: localizedPath(locale, "/contributions/") },
];
// The tab whose section you're in gets a lit link light.
const path = Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`;
const isCurrent = (url: string) =>
    url === home ? path === home : path.startsWith(url);
const otherLocale: Locale = locale === "en" ? "zh-TW" : "en";
const languageLabel = locale === "en" ? "繁體中文" : "English";
const languageUrl = localizedPath(otherLocale, Astro.url.pathname);
---

<header
    class="fixed inset-x-0 top-0 z-50 border-b border-border bg-background/85 backdrop-blur-md"
>
    <div
        class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6"
    >
        <a href={home} class="tape text-sm normal-case tracking-normal">
            {SITE_NAME}
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label={T("選單")}>
            {
                tabs.map((tab) => {
                    const current = isCurrent(tab.url);
                    return (
                        <a
                            href={tab.url}
                            aria-current={current ? "page" : undefined}
                            class:list={[
                                "flex h-9 items-center gap-2 rounded-md px-3 text-sm transition-colors hover:bg-foreground/5",
                                current
                                    ? "text-foreground"
                                    : "text-muted-foreground hover:text-foreground",
                            ]}
                        >
                            <span
                                class:list={["led", !current && "led-off"]}
                                aria-hidden="true"
                            />
                            {tab.name}
                        </a>
                    );
                })
            }
            <span class="mx-2 h-5 w-px bg-border" aria-hidden="true"></span>
            <a
                href={languageUrl}
                lang={otherLocale}
                hreflang={otherLocale}
                class="flex h-9 items-center gap-1.5 rounded-md px-2.5 text-sm text-muted-foreground transition-colors hover:bg-foreground/5 hover:text-foreground"
            >
                <Languages class="size-4" aria-hidden="true" />
                {languageLabel}
            </a>
            <ThemeToggle locale={locale} />
        </nav>

        <button
            type="button"
            data-menu-toggle
            aria-label={T("選單")}
            aria-expanded="false"
            class="flex size-10 items-center justify-center rounded-md transition-colors hover:bg-foreground/5 md:hidden"
        >
            <MenuIcon class="size-5" aria-hidden="true" />
        </button>
    </div>

    <div
        data-mobile-menu
        hidden
        class="border-t border-border bg-background px-4 pb-4 md:hidden"
    >
        <nav class="flex flex-col py-2" aria-label={T("選單")}>
            {
                tabs.map((tab) => {
                    const current = isCurrent(tab.url);
                    return (
                        <a
                            href={tab.url}
                            aria-current={current ? "page" : undefined}
                            class="flex items-center gap-3 border-b border-border/60 py-3 last:border-b-0"
                        >
                            <span
                                class:list={["led", !current && "led-off"]}
                                aria-hidden="true"
                            />
                            {tab.name}
                        </a>
                    );
                })
            }
        </nav>
        <div class="flex items-center justify-between">
            <a
                href={languageUrl}
                lang={otherLocale}
                hreflang={otherLocale}
                class="flex items-center gap-2 py-2 text-sm text-muted-foreground"
            >
                <Languages class="size-4" aria-hidden="true" />
                {languageLabel}
            </a>
            <ThemeToggle locale={locale} />
        </div>
    </div>
</header>

<script>
    const menuToggle = document.querySelector("[data-menu-toggle]");
    const mobileMenu = document.querySelector("[data-mobile-menu]");
    menuToggle?.addEventListener("click", () => {
        if (!(mobileMenu instanceof HTMLElement)) return;
        mobileMenu.hidden = !mobileMenu.hidden;
        menuToggle.setAttribute("aria-expanded", String(!mobileMenu.hidden));
    });
</script>
