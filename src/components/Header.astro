---
import Link from "./Link.astro";
import ThemeToggle from "./ThemeToggle.astro";
import {
    createTranslator,
    defaultLocale,
    localizedPath,
    type Locale,
} from "../i18n";

interface Props {
    locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const T = createTranslator(locale);
const tabs = [
    { name: T("首頁"), url: localizedPath(locale, "/") },
    { name: T("部落格"), url: localizedPath(locale, "/blog/") },
    {
        name: T("貢獻"),
        shortName: T("貢獻", "short"),
        url: localizedPath(locale, "/contributions/"),
    },
    { name: T("主機服務"), url: localizedPath(locale, "/hosting/") },
];
---

<header>
    <div class="hidden md:block">
        <nav class="fixed right-0 z-999 flex flex-row px-7 py-6">
            <div
                class="z-999 flex max-w-[calc(100vw-1rem)] items-center gap-1 overflow-x-auto rounded-lg p-2 shadow-lg backdrop-blur-md"
            >
                {
                    tabs.map((tab) => (
                        <Link
                            href={tab.url}
                            class="mx-1 shrink-0 whitespace-nowrap px-1 transition-all duration-300"
                        >
                            {tab.name}
                        </Link>
                    ))
                }
                <ThemeToggle locale={locale} />
            </div>
        </nav>
    </div>

    <div class="block md:hidden">
        <nav
            class="fixed inset-x-0 z-50 mt-4 flex w-full flex-row justify-center"
        >
            <div
                class="z-999 flex max-w-[calc(100vw-1rem)] items-center gap-1 overflow-x-auto rounded-lg p-2 text-sm shadow-lg backdrop-blur-md"
            >
                {
                    tabs.map((tab) => (
                        <Link
                            href={tab.url}
                            class="mx-1 shrink-0 whitespace-nowrap px-1 transition-all duration-300"
                        >
                            {tab.shortName ?? tab.name}
                        </Link>
                    ))
                }
                <ThemeToggle locale={locale} />
            </div>
        </nav>
    </div>
</header>
