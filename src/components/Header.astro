---
import Link from "./Link.astro";
import ThemeToggle from "./ThemeToggle.astro";
import {
    defaultLocale,
    localizedPath,
    translations,
    type Locale,
} from "../i18n";

interface Props {
    locale?: Locale;
    translationPath?: string;
}

const {
    locale = defaultLocale,
    translationPath = Astro.url.pathname,
} = Astro.props;
const copy = translations[locale];
const tabs = [
    { name: copy.nav.home, url: localizedPath(locale, "/") },
    { name: copy.nav.blog, url: localizedPath(locale, "/blog/") },
    {
        name: copy.nav.contributions,
        shortName: copy.nav.contributionsShort,
        url: localizedPath(locale, "/contributions/"),
    },
    { name: copy.nav.hosting, url: localizedPath(locale, "/hosting/") },
];
const otherLocale: Locale = locale === "en" ? "zh-TW" : "en";
const languageLabel = locale === "en" ? "繁中" : "EN";
const languageUrl = localizedPath(otherLocale, translationPath);
---

<header>
    <div class="hidden md:block">
        <nav class="fixed right-0 z-999 flex flex-row px-7 py-6">
            <div
                class="z-999 flex max-w-[calc(100vw-1rem)] items-center gap-1 overflow-x-auto rounded-lg p-2 shadow-lg backdrop-blur-md"
            >
                {
                    tabs.map((tab) => (
                        <Link
                            href={tab.url}
                            class="mx-1 px-1  transition-all duration-300"
                        >
                            {tab.name}
                        </Link>
                    ))
                }
                <Link
                    href={languageUrl}
                    lang={otherLocale}
                    hreflang={otherLocale}
                    aria-label={copy.nav.language}
                    class="mx-1 px-1 font-bold transition-all duration-300"
                >
                    {languageLabel}
                </Link>
                <ThemeToggle locale={locale} />
            </div>
        </nav>
    </div>

    <div class="block md:hidden">
        <nav
            class="fixed inset-x-0 z-50 mt-4 flex w-full flex-row justify-center"
        >
            <div
                class="z-999 flex max-w-[calc(100vw-1rem)] items-center gap-1 overflow-x-auto rounded-lg p-2 text-sm shadow-lg backdrop-blur-md"
            >
                {
                    tabs.map((tab) => (
                        <Link
                            href={tab.url}
                            class="mx-1 px-1  transition-all duration-300"
                        >
                            {tab.shortName ?? tab.name}
                        </Link>
                    ))
                }
                <Link
                    href={languageUrl}
                    lang={otherLocale}
                    hreflang={otherLocale}
                    aria-label={copy.nav.language}
                    class="mx-1 px-1 font-bold transition-all duration-300"
                >
                    {languageLabel}
                </Link>
                <ThemeToggle locale={locale} />
            </div>
        </nav>
    </div>
</header>
