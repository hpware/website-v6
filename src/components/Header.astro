---
import Link from "./Link.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { SITE_NAME } from "../consts";
import {
    createTranslator,
    defaultLocale,
    localizedPath,
    type Locale,
} from "../i18n";
import {
    FileTextIcon,
    HandHelping,
    HouseIcon,
    Languages,
    MenuIcon,
    ServerIcon,
    Utensils,
} from "@lucide/astro";

interface Props {
    locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const T = createTranslator(locale);
const tabs = [
    { name: T("首頁"), icon: HouseIcon, url: localizedPath(locale, "/") },
    {
        name: T("部落格"),
        icon: FileTextIcon,
        url: localizedPath(locale, "/blog/"),
    },
    { name: T("美食"), icon: Utensils, url: localizedPath(locale, "/food/") },
    {
        name: T("貢獻"),
        icon: HandHelping,
        url: localizedPath(locale, "/contributions/"),
    },
    {
        name: T("主機服務"),
        icon: ServerIcon,
        url: localizedPath(locale, "/hosting/"),
    },
];
const otherLocale: Locale = locale === "en" ? "zh-TW" : "en";
const languageLabel = locale === "en" ? "繁體中文" : "English";
const languageUrl = localizedPath(otherLocale, Astro.url.pathname);
---

<header>
    <div class="fixed inset-x-0 top-0 z-50">
        <nav
            data-navbar
            class="flex flex-row justify-between border border-gray-300/0 rounded-xl px-4 py-2 text-center backdrop-blur-lg transition-all duration-300 data-[scrolled]:mx-7 data-[scrolled]:mt-5 data-[scrolled]:rounded-2xl data-[scrolled]:border-gray-300/30 data-[scrolled]:px-3 data-[scrolled]:py-1 data-[scrolled]:shadow-lg"
        >
            <div class="mx-2">
                <div class="flex flex-row items-center justify-center text-center">
                    <a
                        href={localizedPath(locale, "/")}
                        class="flex h-11 items-center text-xl font-bold whitespace-nowrap"
                    >
                        {SITE_NAME}
                    </a>
                </div>
            </div>

            <div class="hidden flex-row items-center justify-center text-center gap-3 px-1 mx-1 md:flex">
                {tabs.map((tab) => (
                    <Link href={tab.url} class="flex h-11 items-center">
                        <span class="flex flex-row items-center gap-1.5">
                            <tab.icon
                                class="size-5 shrink-0"
                                aria-hidden="true"
                            />
                            <span class="leading-none">{tab.name}</span>
                        </span>
                    </Link>
                ))}
                <ThemeToggle locale={locale} />
            </div>

            <div class="flex flex-row items-center justify-center text-center px-1 mx-1 md:hidden">
                <button
                    type="button"
                    data-menu-toggle
                    aria-label={T("選單")}
                    class="flex h-11 w-11 items-center justify-center rounded-lg transition-all duration-200 hover:bg-gray-500/20 dark:hover:bg-white/20"
                >
                    <MenuIcon class="size-5" aria-hidden="true" />
                </button>
            </div>
        </nav>

        <div
            data-mobile-menu
            hidden
            class="mx-7 mt-2 flex-col overflow-hidden rounded-2xl border border-gray-300/30 bg-background/90 p-2 shadow-lg backdrop-blur-lg md:hidden"
        >
            {tabs.map((tab) => (
                <Link
                    href={tab.url}
                    class="flex flex-row items-center gap-3 p-3"
                >
                    <tab.icon class="size-5 shrink-0" aria-hidden="true" />
                    <span>{tab.name}</span>
                </Link>
            ))}
            <div class="mx-3 my-1 border-t border-gray-300/20"></div>
            <div class="flex flex-row items-center justify-between p-1">
                <Link
                    href={languageUrl}
                    lang={otherLocale}
                    hreflang={otherLocale}
                    class="flex flex-row items-center gap-3 p-2"
                >
                    <Languages aria-hidden="true" class="size-5 shrink-0" />
                    <span>{languageLabel}</span>
                </Link>
                <ThemeToggle locale={locale} />
            </div>
        </div>
    </div>
</header>

<script>
    const navbar = document.querySelector("[data-navbar]");
    const handleScroll = () => {
        if (!navbar) return;
        if (window.scrollY > 10) {
            navbar.setAttribute("data-scrolled", "");
        } else {
            navbar.removeAttribute("data-scrolled");
        }
    };
    handleScroll();
    window.addEventListener("scroll", handleScroll);

    const menuToggle = document.querySelector("[data-menu-toggle]");
    const mobileMenu = document.querySelector("[data-mobile-menu]");
    menuToggle?.addEventListener("click", () => {
        if (mobileMenu instanceof HTMLElement) {
            mobileMenu.hidden = !mobileMenu.hidden;
        }
    });

    const languageSelect = document.querySelector("[data-language-select]");
    languageSelect?.addEventListener("change", (event) => {
        if (event.target instanceof HTMLSelectElement) {
            window.location.href = event.target.value;
        }
    });
</script>
