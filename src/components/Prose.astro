---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div">;
---

<div
    {...Astro.props}
    class="prose prose-slate max-w-none dark:prose-invert
    prose-headings:font-bold prose-headings:tracking-tight prose-headings:no-underline prose-headings:scroll-mt-24
    prose-h1:text-3xl prose-h2:mt-12 prose-h2:text-2xl prose-h3:mt-8 prose-h3:text-xl
    prose-p:text-left prose-p:leading-8 prose-li:leading-7
    prose-a:font-normal prose-a:text-primary prose-a:underline prose-a:decoration-primary/30 prose-a:underline-offset-4 hover:prose-a:decoration-primary dark:prose-a:text-primary
    prose-strong:font-bold
    prose-blockquote:border-l-4 prose-blockquote:border-primary/40 prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:text-muted-foreground
    prose-code:rounded-md prose-code:bg-foreground/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.875em] prose-code:font-normal
    prose-code:before:content-none prose-code:after:content-none
    prose-pre:rounded-xl prose-pre:border prose-pre:border-foreground/10 prose-pre:text-sm prose-pre:leading-[1.6]
    prose-img:mx-auto prose-img:rounded-xl prose-img:shadow-lg
    prose-hr:border-border
    prose-table:text-sm prose-th:text-left
    [&_pre_code]:bg-transparent [&_pre_code]:p-0"
>
    <slot />
</div>
