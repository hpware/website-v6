---
import { Scroll, Award, Flag, Building2 } from "@lucide/astro";
import { achievements as achievementData } from "../data/achievements";

interface Achievement {
    icon: any;
    title: string;
    date: string;
    description: string;
}

interface Props {
    achievements?: Achievement[];
}

export const defaults: Achievement[] = achievementData.map((item) => ({
    ...item,
    icon: { scroll: Scroll, award: Award, flag: Flag, building: Building2 }[item.icon],
}));

const { achievements = defaults } = Astro.props;
---

<ol class="ach mx-auto flex w-full max-w-2xl flex-col md:max-w-none md:flex-row">
    {achievements.map((item, i) => {
        const Icon = item.icon;
        const isLast = i === achievements.length - 1;
        return (
            <li class="ach-item">
                <span class="ach-node flex h-16 w-16 shrink-0 items-center justify-center rounded-lg border border-border bg-card text-foreground">
                    <Icon class="h-6 w-6" />
                </span>
                {!isLast && <span class="ach-line" aria-hidden="true" />}
                <div class="ach-content">
                    <span class="tape">{item.date}</span>
                    <h3 class="mt-2 text-lg leading-snug text-balance">{item.title}</h3>
                    <p
                        class="mt-1 text-sm leading-6 text-muted-foreground"
                        set:html={item.description.replaceAll("\n", "<br/>")}
                    />
                </div>
            </li>
        );
    })}
</ol>

<style>
    /* --- Mobile: vertical timeline, node-left / content-right --- */
    .ach-item {
        position: relative;
        display: flex;
        flex-direction: row;
        gap: 1.25rem;
        min-width: 0;
    }

    .ach-content {
        width: 100%;
        min-width: 0;
        padding-top: 0.5rem;
        padding-bottom: 3rem;
    }

    /* Packets moving down a patch cable — node center to node center */
    .ach-line {
        position: absolute;
        left: 31px; /* node center (32px) − half line width (1px) */
        top: 72px; /* just below the 64px node */
        width: 2px;
        height: calc(100% - 76px);
        background-image: repeating-linear-gradient(
            to bottom,
            var(--primary) 0,
            var(--primary) 4px,
            transparent 4px,
            transparent 16px
        );
        background-size: 2px 16px;
        background-repeat: repeat-y;
        animation: ach-dash-y 0.6s linear infinite;
    }

    /* --- Desktop: horizontal timeline, node-top / content-below --- */
    @media (min-width: 768px) {
        .ach-item {
            flex: 1;
            flex-direction: column;
            align-items: center;
            gap: 0;
            text-align: center;
        }

        .ach-content {
            padding-top: 1rem;
            padding-bottom: 0;
            padding-inline: 0.5rem;
        }

        /* X axis: from this node's center to the next node's center */
        .ach-line {
            left: calc(50% + 32px); /* this node center + radius */
            top: 31px; /* node vertical center (32px) − half line (1px) */
            width: calc(100% - 64px); /* reach next node, minus both radii */
            height: 2px;
            background-image: repeating-linear-gradient(
                to right,
                var(--primary) 0,
                var(--primary) 4px,
                transparent 4px,
                transparent 16px
            );
            background-size: 16px 2px;
            background-repeat: repeat-x;
            animation: ach-dash-x 0.6s linear infinite;
        }
    }

    @keyframes ach-dash-y {
        to {
            background-position-y: 16px;
        }
    }

    @keyframes ach-dash-x {
        to {
            background-position-x: 16px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .ach-line {
            animation: none;
        }
    }
</style>
