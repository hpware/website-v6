---
import { Scroll, Award, Flag, Building2 } from "@lucide/astro";
import { achievements as achievementData } from "../data/achievements";

interface Achievement {
    icon: any;
    title: string;
    date: string;
    description: string;
}

interface Props {
    achievements?: Achievement[];
}

export const defaults: Achievement[] = achievementData.map((item) => ({
    ...item,
    icon: { scroll: Scroll, award: Award, flag: Flag, building: Building2 }[item.icon],
}));

const { achievements = defaults } = Astro.props;
---

<ol class="ach mx-auto flex w-full max-w-2xl flex-col md:max-w-none md:flex-row">
    {achievements.map((item, i) => {
        const Icon = item.icon;
        const isLast = i === achievements.length - 1;
        return (
            <li class="ach-item">
                <div class="ach-node-wrapper">
                    <span class="ach-node flex h-16 w-16 shrink-0 items-center justify-center rounded-full border-2 border-border bg-card text-foreground shadow-sm transition-colors duration-200">
                        <Icon class="h-7 w-7 text-foreground" />
                    </span>
                    {!isLast && <span class="ach-line" aria-hidden="true" />}
                </div>
                <div class="ach-content">
                    <span class="text-sm font-semibold tracking-wider text-muted-foreground uppercase">
                        {item.date}
                    </span>
                    <h3 class="mt-1 text-lg font-bold text-foreground">{item.title}</h3>
                    <p
                        class="mt-1.5 text-sm leading-relaxed text-muted-foreground"
                        set:html={item.description.replaceAll("\n", "<br/>")}
                    />
                </div>
            </li>
        );
    })}
</ol>

<style>
    /* --- Mobile: vertical timeline, node-left / content-right --- */
    .ach-item {
        display: flex;
        flex-direction: row;
        gap: 1.25rem;
    }

    .ach-node-wrapper {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
    }

    .ach-content {
        padding-top: 0.5rem;
        padding-bottom: 3rem;
        flex: 1;
    }

    /* Vertical dashed connector using site border color */
    .ach-line {
        position: absolute;
        top: 64px;
        bottom: -1rem;
        left: 50%;
        width: 2px;
        transform: translateX(-50%);
        background-image: repeating-linear-gradient(
            to bottom,
            var(--border) 0,
            var(--border) 6px,
            transparent 6px,
            transparent 12px
        );
        background-size: 2px 12px;
        background-repeat: repeat-y;
    }

    /* --- Desktop: horizontal timeline, node-top / content-below --- */
    @media (min-width: 768px) {
        .ach-item {
            flex: 1 1 0%;
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            text-align: center;
        }

        .ach-node-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 64px;
        }

        .ach-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-top: 1.25rem;
            padding-bottom: 0;
            padding-inline: 0.75rem;
        }

        /* Horizontal dashed connector using site border color */
        .ach-line {
            position: absolute;
            left: calc(50% + 32px);
            top: 50%;
            bottom: auto;
            width: calc(100% - 64px);
            height: 2px;
            transform: translateY(-50%);
            background-image: repeating-linear-gradient(
                to right,
                var(--border) 0,
                var(--border) 6px,
                transparent 6px,
                transparent 12px
            );
            background-size: 12px 2px;
            background-repeat: repeat-x;
        }
    }
</style>
