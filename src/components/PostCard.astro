---
// One row in a list of blog posts or food reviews. Extra pills (rating, location...) go in the slot.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";
import { createTranslator, type Locale } from "../i18n";

interface Props {
    href: string;
    title: string;
    description?: string;
    date: Date;
    locale: Locale;
    image?: ImageMetadata;
}

const { href, title, description, date, locale, image } = Astro.props;
const T = createTranslator(locale);
---

<a
    href={href}
    class="flex items-start gap-4 rounded-lg border border-foreground/15 px-5 py-4 transition-colors duration-200 hover:bg-foreground/5"
>
    <div class="min-w-0 flex-1">
        <span class="block text-xl">{title}</span>
        {
            description && (
                <span class="mt-1 line-clamp-1 block text-sm text-muted-foreground">
                    {description}
                </span>
            )
        }
        <div
            class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-sm text-muted-foreground"
        >
            <small class="text-sm">
                {T("發佈於")}{" "}
                <FormattedDate date={date} locale={locale} />
            </small>
            <slot />
        </div>
    </div>
    {
        image && (
            <Image
                src={image}
                width={160}
                height={160}
                alt=""
                class="size-20 shrink-0 rounded-md object-cover"
            />
        )
    }
</a>
