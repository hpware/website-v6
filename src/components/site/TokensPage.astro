---
import Layout from "../../layouts/Default.astro";
import { createTranslator, type Locale } from "../../i18n";
import Link from "../Link.astro";

interface Props {
    locale: Locale;
}

// Only the fields of https://tokscale.ai/api/users/<username> this page uses.
interface TokscaleProfile {
    stats: {
        totalTokens: number;
        totalCost: number;
        inputTokens: number;
        outputTokens: number;
        cacheReadTokens: number;
        cacheWriteTokens: number;
        activeDays: number;
        sessionCount: number;
    };
    chartRange: { start: string; end: string };
    updatedAt: string;
    modelUsage: { model: string; tokens: number; cost: number }[];
    contributions: {
        date: string;
        totals: { tokens: number; cost: number };
        clients: { client: string; cost: number }[];
    }[];
}

const USERNAME = "hpware";
const PROFILE_URL = `https://tokscale.ai/u/${USERNAME}`;

const { locale } = Astro.props;
const T = createTranslator(locale);

let profile: TokscaleProfile | null = null;
try {
    const response = await fetch(
        `https://tokscale.ai/api/users/${USERNAME}`,
        { signal: AbortSignal.timeout(5000) },
    );
    if (response.ok) profile = (await response.json()) as TokscaleProfile;
} catch {
    // Tokscale is down or slow; the page shows a fallback message instead.
}

const numberLocale = locale === "zh-TW" ? "zh-TW" : "en-US";
const compact = new Intl.NumberFormat(numberLocale, {
    notation: "compact",
    maximumFractionDigits: 1,
});
const usd = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
});

// Costs keyed by day, for the heatmap and per-client totals.
const costByDay = new Map<string, number>();
const costByClient = new Map<string, number>();
for (const day of profile?.contributions ?? []) {
    costByDay.set(day.date, day.totals.cost);
    for (const client of day.clients) {
        costByClient.set(
            client.client,
            (costByClient.get(client.client) ?? 0) + client.cost,
        );
    }
}

const topModels = [...(profile?.modelUsage ?? [])]
    .sort((a, b) => b.cost - a.cost)
    .slice(0, 10);
const topClients = [...costByClient]
    .filter(([, cost]) => cost >= 1)
    .sort((a, b) => b[1] - a[1]);

// GitHub-style grid of the last year, one column per week (Sunday first).
// Shades use a log scale since a few heavy days would otherwise wash out the rest.
const weeks: { date: string; cost: number; level: number }[][] = [];
if (profile) {
    const end = new Date(`${profile.chartRange.end}T00:00:00Z`);
    const cursor = new Date(`${profile.chartRange.start}T00:00:00Z`);
    cursor.setUTCDate(cursor.getUTCDate() - cursor.getUTCDay());
    const maxLog = Math.log1p(Math.max(0, ...costByDay.values()));

    while (cursor <= end) {
        const week = [];
        for (let i = 0; i < 7; i++) {
            const date = cursor.toISOString().slice(0, 10);
            const cost = costByDay.get(date) ?? 0;
            const level =
                cost <= 0 || maxLog === 0
                    ? 0
                    : Math.max(1, Math.ceil((Math.log1p(cost) / maxLog) * 4));
            week.push({ date, cost, level });
            cursor.setUTCDate(cursor.getUTCDate() + 1);
        }
        weeks.push(week);
    }
}
const levelClasses = [
    "bg-muted-foreground/10",
    "bg-accent/25",
    "bg-accent/50",
    "bg-accent/75",
    "bg-accent",
];

const tokenBreakdown = profile
    ? [
          { label: T("輸入"), value: profile.stats.inputTokens },
          { label: T("輸出"), value: profile.stats.outputTokens },
          { label: T("快取讀取"), value: profile.stats.cacheReadTokens },
          { label: T("快取寫入"), value: profile.stats.cacheWriteTokens },
      ]
    : [];
---

<Layout
    locale={locale}
    translationPath="/tokens/"
    title={T("AI 補貼")}
    description={T("我用 AI 花掉的 token，以 API 價格計算。")}
>
    <div class="mx-auto max-w-3xl pb-16">
        <h1 class="text-2xl">{T("AI 補貼")}</h1>
        <p class="mt-2 text-sm text-muted-foreground">
            {T("我用 AI 花掉的 token，以 API 價格計算。大部分都是訂閱方案吃掉的，所以這些錢其實是 AI 公司在補貼我。")}
        </p>

        {
            profile === null ? (
                <p class="mt-10 rounded-lg border border-accent p-4 text-sm">
                    {T("目前無法從 Tokscale 取得資料，請稍後再試。")}{" "}
                    <Link href={PROFILE_URL}>{T("在 Tokscale 上查看")}</Link>
                </p>
            ) : (
                <>
                    <section class="mt-10">
                        <p class="text-sm text-muted-foreground">
                            {T("以 API 價格計算的總花費")}
                        </p>
                        <p class="mt-1 text-5xl font-bold">
                            {usd.format(profile.stats.totalCost)}
                        </p>
                        <dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
                            <div class="rounded-lg border border-accent p-4">
                                <dt class="text-xs text-muted-foreground">
                                    {T("總 token 數")}
                                </dt>
                                <dd class="mt-1 text-xl">
                                    {compact.format(profile.stats.totalTokens)}
                                </dd>
                            </div>
                            <div class="rounded-lg border border-accent p-4">
                                <dt class="text-xs text-muted-foreground">
                                    {T("活躍天數")}
                                </dt>
                                <dd class="mt-1 text-xl">
                                    {profile.stats.activeDays}
                                </dd>
                            </div>
                            <div class="rounded-lg border border-accent p-4">
                                <dt class="text-xs text-muted-foreground">
                                    {T("工作階段")}
                                </dt>
                                <dd class="mt-1 text-xl">
                                    {compact.format(profile.stats.sessionCount)}
                                </dd>
                            </div>
                        </dl>
                        <p class="mt-4 text-sm text-muted-foreground">
                            {tokenBreakdown
                                .map(
                                    (item) =>
                                        `${item.label} ${compact.format(item.value)}`,
                                )
                                .join(" · ")}
                        </p>
                    </section>

                    <section class="mt-10" aria-labelledby="tokens-daily">
                        <h2 id="tokens-daily" class="text-xl">
                            {T("過去一年")}
                        </h2>
                        <div class="mt-4 overflow-x-auto pb-2">
                            <div class="flex w-max gap-[3px]">
                                {weeks.map((week) => (
                                    <div class="flex flex-col gap-[3px]">
                                        {week.map((day) => (
                                            <div
                                                class={`size-2.5 rounded-[2px] ${levelClasses[day.level]}`}
                                                title={`${day.date}: ${usd.format(day.cost)}`}
                                            />
                                        ))}
                                    </div>
                                ))}
                            </div>
                        </div>
                    </section>

                    <section class="mt-10" aria-labelledby="tokens-models">
                        <h2 id="tokens-models" class="text-xl">
                            {T("花最多的模型")}
                        </h2>
                        <ul class="mt-4 flex flex-col gap-3">
                            {topModels.map((model) => (
                                <li>
                                    <div class="flex justify-between gap-4 text-sm">
                                        <code>{model.model}</code>
                                        <span class="text-muted-foreground">
                                            {usd.format(model.cost)} ·{" "}
                                            {compact.format(model.tokens)}
                                        </span>
                                    </div>
                                    <div class="mt-1 h-1.5 rounded-full bg-muted-foreground/10">
                                        <div
                                            class="h-full rounded-full bg-accent"
                                            style={`width: ${(model.cost / topModels[0].cost) * 100}%`}
                                        />
                                    </div>
                                </li>
                            ))}
                        </ul>
                    </section>

                    <section class="mt-10" aria-labelledby="tokens-clients">
                        <h2 id="tokens-clients" class="text-xl">
                            {T("用的工具")}
                        </h2>
                        <ul class="mt-4 flex flex-wrap gap-2 text-sm">
                            {topClients.map(([client, cost]) => (
                                <li class="rounded-lg border border-accent px-3 py-1">
                                    {client}{" "}
                                    <span class="text-muted-foreground">
                                        {usd.format(cost)}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    </section>

                    <p class="mt-10 text-xs text-muted-foreground">
                        {T("資料來源：")}
                        <Link href={PROFILE_URL}>Tokscale</Link>
                        {" · "}
                        {T("更新於")}{" "}
                        {new Date(profile.updatedAt).toLocaleString(
                            numberLocale,
                            { timeZone: "Asia/Taipei" },
                        )}
                    </p>
                </>
            )
        }
    </div>
</Layout>
