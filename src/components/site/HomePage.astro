---
import AchievementsTimeline from "../AchievementsTimeline.astro";
import Layout from "../../layouts/Default.astro";
import { createTranslator, type Locale } from "../../i18n";
import { CheckIcon, CopyIcon } from "@lucide/astro";
import { birthday } from "../../data/about.json";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);

// Both dates are "YYYY-MM-DD", so the month-day parts compare as plain strings.
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Taipei" }).format(new Date());
const hadBirthdayThisYear = today.slice(5) >= birthday.slice(5);
const age = Number(today.slice(0, 4)) - Number(birthday.slice(0, 4)) - (hadBirthdayThisYear ? 0 : 1);
const aboutMe = [`${age} ${T("歲")}`, T("五專生"), T("喜歡 TypeScript 和 Linux 伺服器")];
---

<Layout locale={locale} translationPath="/" title={T("首頁")}>
    <section class="flex min-h-[calc(100vh-5rem)] items-center font-sans">
        <div class="mx-auto w-full max-w-3xl px-6 py-16 text-left sm:px-10">
            <h1 class="text-3xl leading-[1.1] font-bold sm:text-4xl md:text-5xl">
                {T("嗨！")}
            </h1>
            <p class="mt-6 text-xl leading-tight text-muted-foreground sm:text-2xl md:text-3xl">
                {T("這是元皓的網站！")}
            </p>
            <p class="mt-4 text-base text-muted-foreground sm:text-lg">
                {aboutMe.join(" · ")}
            </p>

            <div class="mt-8 flex w-fit max-w-full items-center gap-3 rounded-lg border border-foreground/15 px-4 py-2.5 sm:gap-4 sm:px-5">
                <code class="overflow-x-auto font-mono text-sm tracking-wide sm:text-base" data-ssh-command>ssh t.yuanhau.com</code>
                <button
                    type="button"
                    class="shrink-0 rounded-md p-1.5 transition-colors hover:bg-foreground/10 focus-visible:ring-2 focus-visible:ring-foreground/50 focus-visible:outline-none"
                    aria-label={T("複製指令")}
                    data-ssh-copy
                >
                    <CopyIcon class="size-5" aria-hidden="true" data-copy-icon />
                    <CheckIcon class="hidden size-5 text-green-500" aria-hidden="true" data-copied-icon />
                </button>
            </div>
        </div>
    </section>

    <section class="mx-auto w-full max-w-2xl px-4 pb-24">
        <h2 class="mb-10 text-center text-3xl font-bold">{T("成就")}</h2>
        <AchievementsTimeline />
    </section>

</Layout>

<script>
    const copyButton = document.querySelector("[data-ssh-copy]");
    const command = document.querySelector("[data-ssh-command]");
    const copyIcon = document.querySelector("[data-copy-icon]");
    const copiedIcon = document.querySelector("[data-copied-icon]");

    copyButton?.addEventListener("click", async () => {
        if (!(command instanceof HTMLElement)) return;
        await navigator.clipboard.writeText(command.textContent ?? "");
        copyIcon?.classList.add("hidden");
        copiedIcon?.classList.remove("hidden");
        window.setTimeout(() => {
            copyIcon?.classList.remove("hidden");
            copiedIcon?.classList.add("hidden");
        }, 1500);
    });
</script>
