---
import AchievementsTimeline from "../AchievementsTimeline.astro";
import Layout from "../../layouts/Default.astro";
import { createTranslator, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);
---

<Layout locale={locale} translationPath="/" title={T("首頁")}>
    <section
        class="flex min-h-[calc(100vh-5rem)] items-center justify-center px-2 font-sans"
    >
        <h1
            class="w-full max-w-4xl text-left text-4xl leading-[1.08] font-bold tracking-tight text-foreground sm:text-5xl md:text-7xl"
        >
            <span class="block">{T("嗨！")}</span>
            <span class="block">{T("這是元皓的網站！")}</span>
        </h1>
    </section>

    <section class="mx-auto w-full max-w-2xl px-4 pb-24">
        <h2 class="mb-10 text-center text-3xl font-bold">{T("成就")}</h2>
        <AchievementsTimeline />
    </section>
</Layout>
