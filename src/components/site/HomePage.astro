---
import AchievementsTimeline from "../AchievementsTimeline.astro";
import Layout from "../../layouts/Default.astro";
import { createTranslator, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);
---

<Layout locale={locale} translationPath="/" title={T("首頁")}>
    <section class="font-sans">
        <div class="absolute inset-0 flex min-h-screen flex-col justify-center">
            <div class="m-auto w-full px-6 text-left md:w-fit">
                <h1
                    class="text-3xl leading-tight font-bold sm:text-4xl md:text-5xl"
                >
                    {T("嗨！")}
                </h1>
                <h1
                    class="text-xl leading-tight font-bold sm:text-2xl md:text-3xl"
                >
                    {T("這是元皓的網站！")}
                </h1>
            </div>
        </div>
        <div class="min-h-screen" aria-hidden="true"></div>
    </section>

    <section class="mx-auto w-full max-w-2xl px-4 pb-24">
        <h2 class="mb-10 text-center text-3xl font-bold">{T("成就")}</h2>
        <AchievementsTimeline />
    </section>

    <section class="mx-auto w-full max-w-2xl px-4 pb-12" aria-labelledby="ssh-heading">
        <div class="rounded-2xl border border-foreground/15 p-6 sm:p-8">
            <h2 id="ssh-heading" class="text-2xl font-bold">{T("自訂 SSH 伺服器")}</h2>
            <p class="mt-3 text-muted-foreground">{T("開啟終端機並執行以下指令：")}</p>
            <pre class="mt-5 overflow-x-auto rounded-xl bg-foreground/5 p-4"><code class="select-all font-mono text-base">ssh t.yuanhau.com</code></pre>
        </div>
    </section>
</Layout>
