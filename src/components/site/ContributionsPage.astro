---
import { ArrowUpRight } from "@lucide/astro";
import contributionData from "../../data/contributions.json";
import Layout from "../../layouts/Default.astro";
import { createTranslator, type Locale } from "../../i18n";

interface ContributionLink {
    label: string;
    url: string;
}

interface ContributionItem {
    slug: string;
    title: string;
    description: string;
    isUnmaintained?: boolean;
    categories: string[];
    links: ContributionLink[];
}

interface ContributionSection {
    id: string;
    title: string;
    description: string | null;
    items: ContributionItem[];
}

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);
const sections = contributionData as ContributionSection[];
const total = sections.reduce((sum, section) => sum + section.items.length, 0);
---

<Layout
    locale={locale}
    translationPath="/contributions/"
    title={T("貢獻")}
    description={T("Howard 的專案、資安研究、錯誤發現與其他貢獻。")}
>
    <div class="mx-auto max-w-6xl pt-8 sm:px-2 md:pt-14">
        <header class="border-b border-border pb-6">
            <span class="tape tape-print">{total} {T("項")}</span>
            <h1 class="mt-4 display-wide text-5xl leading-none sm:text-7xl">
                {T("貢獻")}
            </h1>
            <p class="mt-4 max-w-xl text-lg text-muted-foreground">
                {T("我參與過的專案、研究、發現的錯誤，以及其他工作。")}
            </p>
            <nav class="mt-6 flex flex-wrap gap-2" aria-label={T("貢獻")}>
                {
                    sections.map((section) => (
                        <a
                            href={`#${section.id}`}
                            class="flex items-center gap-2 rounded-md border border-border bg-card px-3 py-1.5 text-sm transition-colors hover:border-primary hover:text-primary"
                        >
                            {section.title}
                            <span class="font-mono text-xs text-muted-foreground">
                                {section.items.length}
                            </span>
                        </a>
                    ))
                }
            </nav>
        </header>

        {
            sections.map((section) => (
                <section
                    id={section.id}
                    class="grid scroll-mt-20 gap-6 border-b border-border py-12 lg:grid-cols-[16rem_1fr] lg:gap-10"
                    aria-labelledby={`${section.id}-heading`}
                >
                    <div class="lg:sticky lg:top-20 lg:self-start">
                        <h2
                            id={`${section.id}-heading`}
                            class="display-tight text-2xl leading-tight sm:text-3xl"
                        >
                            {section.title}
                        </h2>
                        {section.description && (
                            <p class="mt-2 text-sm leading-6 text-muted-foreground">
                                {section.description}
                            </p>
                        )}
                    </div>

                    <ul class="grid gap-3 sm:grid-cols-2">
                        {section.items.map((item, index) => {
                            const itemId = `${section.id}-${index + 1}-${item.slug}`;

                            return (
                                <li
                                    id={itemId}
                                    aria-labelledby={`${itemId}-heading`}
                                    class:list={[
                                        "flex flex-col rounded-lg border bg-card p-5",
                                        item.isUnmaintained
                                            ? "border-dashed border-border bg-card/50"
                                            : "border-border",
                                    ]}
                                >
                                    {(item.categories.length > 0 ||
                                        item.isUnmaintained) && (
                                        <div class="mb-3 flex flex-wrap gap-1.5">
                                            {item.categories.map((category) => (
                                                <span class="tape tape-white">
                                                    {category}
                                                </span>
                                            ))}
                                            {item.isUnmaintained && (
                                                <span class="tape bg-muted text-muted-foreground">
                                                    <span
                                                        class="led led-off"
                                                        aria-hidden="true"
                                                    />
                                                    {T("已停止維護")}
                                                </span>
                                            )}
                                        </div>
                                    )}

                                    <h3
                                        id={`${itemId}-heading`}
                                        class="text-lg leading-snug"
                                    >
                                        {item.title}
                                    </h3>

                                    <p class="mt-2 text-sm leading-6 text-muted-foreground">
                                        {item.description}
                                    </p>

                                    {item.links.length > 0 && (
                                        <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-4 text-sm">
                                            {item.links.map((link) => (
                                                <a
                                                    href={link.url}
                                                    class="group inline-flex items-center gap-1 text-primary"
                                                >
                                                    {link.label}
                                                    <ArrowUpRight
                                                        class="size-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                                        aria-hidden="true"
                                                    />
                                                </a>
                                            ))}
                                        </div>
                                    )}
                                </li>
                            );
                        })}
                    </ul>
                </section>
            ))
        }
    </div>
</Layout>
