---
import { Server, MonitorCog, FlagTriangleRight } from "@lucide/astro";
import Link from "../Link.astro";
import Layout from "../../layouts/Default.astro";
import { createTranslator, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);
---

<Layout
    locale={locale}
    translationPath="/hosting/"
    title={T("免費主機服務")}
    description={T("免費、僅支援 IPv6 的虛擬機主機服務。")}
>
    <div
        class="absolute inset-0 flex flex-col items-center justify-center space-y-3 text-center"
    >
        <span class="text-6xl"
            ><Server
                class="h-20 w-20 transition-all duration-300 hover:-rotate-5 hover:scale-150"
            />{T("免費主機服務")}</span
        >
        <span>
            {T("每人限用一個 HE IPv6 位址，以及一台配有 1 個 CPU 核心與 1 GB 記憶體的虛擬機")}<span class="text-sm">*1</span>
        </span>
        <div class="mt-1 flex flex-col space-x-6 md:flex-row">
            <Link
                href="https://manageut.yhw.tw"
                class="group flex flex-row items-center space-x-1"
            >
                <MonitorCog
                    class="transition-all duration-300 group-hover:-rotate-5 group-hover:scale-110"
                />
                <span class="pl-2">{T("管理虛擬機")}</span>
            </Link>
            <Link
                href="mailto:hlabuse@yhw.tw"
                class="group flex flex-row items-center space-x-1"
            >
                <FlagTriangleRight
                    class="transition-all duration-300 group-hover:-rotate-5 group-hover:scale-110"
                />
                <span class="pl-2">{T("檢舉濫用行為")}</span>
            </Link>
        </div>
    </div>

    <div class="min-h-screen"></div>
    <div class="flex flex-col p-5">
        <span><span class="text-sm">*1</span>&nbsp;:&nbsp;{T("不保證服務可用，且我保留移除虛擬機的權利。")}</span>
    </div>
</Layout>
