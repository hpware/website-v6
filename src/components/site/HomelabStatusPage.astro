---
import { ArrowUpRight } from "@lucide/astro";
import Layout from "../../layouts/Default.astro";
import HomelabTopology from "./HomelabTopology.astro";
import IncidentUpdates from "./IncidentUpdates.astro";
import { createTranslator, localizedPath, type Locale } from "../../i18n";
import { getHomelabStatus, kenerUrl, type Health, type Incident } from "../../lib/homelabStatus";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);
const status = await getHomelabStatus();

// Owner's timezone, like the rest of the site.
const dateTime = new Intl.DateTimeFormat(locale, {
    timeZone: "Asia/Taipei",
    dateStyle: "medium",
    timeStyle: "short",
});
const time = new Intl.DateTimeFormat(locale, { timeZone: "Asia/Taipei", timeStyle: "short" });
const day = new Intl.DateTimeFormat(locale, { timeZone: "Asia/Taipei", dateStyle: "medium" });
const percent = new Intl.NumberFormat(locale, { style: "percent", maximumFractionDigits: 2 });

const overall = {
    operational: { label: T("所有系統正常運作"), dot: "bg-emerald-500" },
    degraded: { label: T("部分系統效能下降"), dot: "bg-amber-500" },
    outage: { label: T("重大服務中斷"), dot: "bg-red-500" },
    maintenance: { label: T("維護中"), dot: "bg-sky-500" },
    unknown: { label: T("無法取得狀態"), dot: "bg-gray-400" },
}[status.overall];

const health: Record<Health, { label: string; bar: string; text: string }> = {
    up: { label: T("正常"), bar: "bg-emerald-500", text: "text-emerald-600 dark:text-emerald-400" },
    down: { label: T("離線"), bar: "bg-red-500", text: "text-red-600 dark:text-red-400" },
    degraded: { label: T("效能下降"), bar: "bg-amber-500", text: "text-amber-600 dark:text-amber-400" },
    pending: { label: T("等待中"), bar: "bg-amber-500", text: "text-amber-600 dark:text-amber-400" },
    maintenance: { label: T("維護中"), bar: "bg-sky-500", text: "text-sky-600 dark:text-sky-400" },
    unknown: { label: T("未知"), bar: "bg-gray-400", text: "text-muted-foreground" },
};

const healthLabels = Object.fromEntries(
    Object.entries(health).map(([key, value]) => [key, value.label]),
) as Record<Health, string>;

const incidentStatus: Record<Incident["status"], string> = {
    investigating: T("調查中"),
    identified: T("已確認原因"),
    monitoring: T("觀察中"),
    resolved: T("已解決"),
};
const impact: Record<Incident["impact"], { label: string; border: string }> = {
    minor: { label: T("輕微影響"), border: "border-l-amber-500" },
    major: { label: T("重大影響"), border: "border-l-red-500" },
    maintenance: { label: T("維護"), border: "border-l-sky-500" },
};

const postUrl = (slug: string) => localizedPath(locale, `/blog/${slug}/`);
const meter = (value: number | undefined) => (value === undefined ? undefined : Math.min(Math.max(value, 0), 100));
const meterColor = (value: number) => (value >= 90 ? "bg-red-500" : value >= 75 ? "bg-amber-500" : "bg-foreground/60");
function duration(seconds: number) {
    const days = Math.floor(seconds / 86400);
    const hours = Math.floor((seconds % 86400) / 3600);
    return days > 0 ? `${days}d ${hours}h` : `${hours}h ${Math.floor((seconds % 3600) / 60)}m`;
}
---

<Layout
    locale={locale}
    translationPath="/hl/status/"
    title={T("家庭實驗室狀態")}
    description={T("家庭實驗室各項服務與伺服器的即時狀態。")}
>
    <div class="mx-auto max-w-3xl pb-16">
        <h1 class="text-2xl">{T("家庭實驗室狀態")}</h1>

        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-xl border border-border p-4">
            <span class:list={["size-3 shrink-0 rounded-full", overall.dot]} aria-hidden="true"></span>
            <p class="flex-1 font-medium">{overall.label}</p>
            <time class="text-xs text-muted-foreground" datetime={new Date(status.checkedAt).toISOString()}>
                {T("檢查時間")} {time.format(status.checkedAt)}
            </time>
        </div>

        <section class="mt-10">
            <h2 class="text-lg">{T("網路架構")}</h2>
            <div class="mt-3 rounded-xl border border-border p-4">
                <HomelabTopology locale={locale} monitors={status.monitors} servers={status.servers ?? []} labels={healthLabels} />
            </div>
        </section>

        {
            status.active.length > 0 && (
                <section class="mt-10">
                    <h2 class="text-lg">{T("進行中的事件")}</h2>
                    <ul class="mt-3 flex flex-col gap-3">
                        {status.active.map((incident) => (
                            <li class:list={["rounded-xl border border-l-4 border-border p-4", impact[incident.impact].border]}>
                                <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                                    <h3 class="font-medium">{incident.title}</h3>
                                    <span class="text-xs text-muted-foreground">
                                        {impact[incident.impact].label} · {incidentStatus[incident.status]}
                                    </span>
                                </div>
                                <IncidentUpdates updates={incident.updates} labels={incidentStatus} format={dateTime} />
                                {incident.post_slug && (
                                    <a href={postUrl(incident.post_slug)} class="mt-3 inline-flex items-center gap-1 text-sm underline">
                                        {T("閱讀完整報告")}
                                        <ArrowUpRight class="size-4" aria-hidden="true" />
                                    </a>
                                )}
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }

        <section class="mt-10">
            <div class="flex items-baseline justify-between gap-3">
                <h2 class="text-lg">{T("服務")}</h2>
                <a href={kenerUrl} class="text-xs text-muted-foreground underline">Kener</a>
            </div>
            {status.failed.kener && <p class="mt-3 text-sm text-muted-foreground">{T("Kener 目前無法連線。")}</p>}
            {
                status.monitors.length > 0 && (
                    <ul class="mt-3 divide-y divide-border rounded-xl border border-border">
                        {status.monitors.map((monitor) => (
                            <li class="p-4">
                                <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                                    <p class="font-medium">{monitor.name}</p>
                                    <p class="text-xs">
                                        <span class={health[monitor.health].text}>{health[monitor.health].label}</span>
                                        {monitor.uptime !== undefined && (
                                            <span class="text-muted-foreground">
                                                {" · "}
                                                {percent.format(monitor.uptime)} {T("30 天")}
                                            </span>
                                        )}
                                    </p>
                                </div>
                                {monitor.days.length > 0 && (
                                    <div class="mt-3 flex h-6 gap-px" role="img" aria-label={`${monitor.name}: ${health[monitor.health].label}`}>
                                        {monitor.days.map((entry) => (
                                            <span
                                                class:list={["flex-1 rounded-[2px]", health[entry.health].bar]}
                                                title={`${day.format(entry.at)} · ${
                                                    entry.uptime === undefined ? health[entry.health].label : percent.format(entry.uptime)
                                                }`}
                                            />
                                        ))}
                                    </div>
                                )}
                            </li>
                        ))}
                    </ul>
                )
            }
        </section>

        {
            status.servers !== undefined && (
                <section class="mt-10">
                    <h2 class="text-lg">{T("伺服器")}</h2>
                    {status.failed.beszel && <p class="mt-3 text-sm text-muted-foreground">{T("Beszel 目前無法連線。")}</p>}
                    {status.servers.length > 0 && (
                        <ul class="mt-3 divide-y divide-border rounded-xl border border-border">
                            {status.servers.map((server) => (
                                <li class="p-4">
                                    <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                                        <p class="font-medium">{server.name}</p>
                                        <p class="text-xs">
                                            <span class={health[server.health].text}>{health[server.health].label}</span>
                                            {server.health === "up" && server.uptime !== undefined && (
                                                <span class="text-muted-foreground">
                                                    {" · "}
                                                    {T("已運作")} {duration(server.uptime)}
                                                </span>
                                            )}
                                        </p>
                                    </div>
                                    {server.health === "up" && (
                                        <dl class="mt-3 grid grid-cols-3 gap-3 text-xs">
                                            {[
                                                ["CPU", meter(server.cpu)],
                                                [T("記憶體"), meter(server.memory)],
                                                [T("磁碟"), meter(server.disk)],
                                            ].map(([label, value]) => (
                                                <div>
                                                    <div class="flex justify-between gap-2">
                                                        <dt class="text-muted-foreground">{label}</dt>
                                                        <dd class="tabular-nums">{typeof value === "number" ? `${Math.round(value)}%` : "—"}</dd>
                                                    </div>
                                                    <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-muted" aria-hidden="true">
                                                        {typeof value === "number" && (
                                                            <div class:list={["h-full rounded-full", meterColor(value)]} style={`width: ${value}%`} />
                                                        )}
                                                    </div>
                                                </div>
                                            ))}
                                        </dl>
                                    )}
                                </li>
                            ))}
                        </ul>
                    )}
                </section>
            )
        }

        <section class="mt-10">
            <h2 class="text-lg">{T("過去的事件")}</h2>
            {status.failed.incidents && <p class="mt-3 text-sm text-muted-foreground">{T("事件紀錄目前無法載入。")}</p>}
            {
                !status.failed.incidents && status.past.length === 0 && (
                    <p class="mt-3 text-sm text-muted-foreground">{T("目前沒有事件紀錄。")}</p>
                )
            }
            <ul class="mt-3 flex flex-col gap-2">
                {
                    status.past.map((incident) => (
                        <li class="rounded-xl border border-border">
                            <details class="group p-4">
                                <summary class="flex cursor-pointer list-none flex-wrap items-baseline justify-between gap-x-3">
                                    <span class="font-medium group-open:underline">{incident.title}</span>
                                    <span class="text-xs text-muted-foreground">
                                        {impact[incident.impact].label} · {dateTime.format(incident.created_at)}
                                    </span>
                                </summary>
                                <IncidentUpdates updates={incident.updates} labels={incidentStatus} format={dateTime} />
                            </details>
                            {incident.post_slug && (
                                <a href={postUrl(incident.post_slug)} class="mx-4 mb-4 -mt-1 inline-flex items-center gap-1 text-sm underline">
                                    {T("閱讀完整報告")}
                                    <ArrowUpRight class="size-4" aria-hidden="true" />
                                </a>
                            )}
                        </li>
                    ))
                }
            </ul>
        </section>
    </div>
</Layout>
