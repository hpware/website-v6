---
import { getCollection } from "astro:content";
import Pill from "../Pill.astro";
import PostCard from "../PostCard.astro";
import Layout from "../../layouts/Default.astro";
import { createTranslator, localizedPath, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);
const reviews = (await getCollection("food"))
    .filter((review) => review.data.status === "published")
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
    locale={locale}
    translationPath="/food/"
    title={T("美食")}
    description={T("美食食記，記錄我吃過的東西。")}
>
    <div class="mx-auto max-w-5xl">
        <h1 class="text-3xl font-bold">{T("食記")}</h1>
        <p class="mt-2 text-sm text-muted-foreground">
            {T("美食食記，記錄我吃過的東西。")}
        </p>
        <ul class="mt-6 grid gap-3 md:grid-cols-2">
            {
                reviews.map((review) => (
                    <li class="grid">
                        <PostCard
                            href={localizedPath(locale, `/food/${review.id}/`)}
                            title={review.data.title}
                            description={review.data.description}
                            date={review.data.pubDate}
                            locale={locale}
                            image={review.data.heroImage}
                        >
                            {review.data.rating !== undefined && (
                                <Pill>
                                    <span class="text-[#e8761f]">★</span>{" "}
                                    {review.data.rating}
                                </Pill>
                            )}
                            {review.data.location && (
                                <Pill>{review.data.location}</Pill>
                            )}
                            {review.data.priceRange && (
                                <Pill>{review.data.priceRange}</Pill>
                            )}
                        </PostCard>
                    </li>
                ))
            }
        </ul>
    </div>
</Layout>
