---
import type { Incident } from "../../lib/homelabStatus";

interface Props {
    updates: Incident["updates"];
    /** Status names in the page's language. */
    labels: Record<Incident["status"], string>;
    format: Intl.DateTimeFormat;
}

const { updates, labels, format } = Astro.props;
---

<ol class="mt-3 flex flex-col gap-3 border-l border-border pl-4">
    {
        [...updates].reverse().map((update) => (
            <li>
                <p class="text-xs text-muted-foreground">
                    <strong class="font-medium text-foreground">{labels[update.status]}</strong>
                    {" · "}
                    <time datetime={new Date(update.at).toISOString()}>{format.format(update.at)}</time>
                </p>
                <p class="mt-1 text-sm whitespace-pre-line">{update.message}</p>
            </li>
        ))
    }
</ol>
