---
import { getCollection } from "astro:content";
import FormattedDate from "../FormattedDate.astro";
import Layout from "../../layouts/Default.astro";
import { createTranslator, localizedPath, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);
const posts = (await getCollection("blog"))
    .filter((post) => post.data.status === "published")
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
    locale={locale}
    translationPath="/blog/"
    title={T("部落格")}
    description={T("歡迎來到我的網站！")}
>
    <div class="mx-auto max-w-3xl">
        <h1 class="text-2xl">{T("貼文")}</h1>
        <ul class="mt-4 flex flex-col gap-4">
            {
                posts.map((post) => (
                    <li>
                        <a
                            href={localizedPath(
                                locale,
                                `/blog/${post.id}/`,
                            )}
                            class="block rounded-lg border border-accent p-4 transition-all duration-300 hover:bg-gray-500/10 dark:hover:bg-white/10"
                        >
                            <span class="text-xl">{post.data.title}</span>
                            <br />
                            <small>
                                {T("發佈於")}{" "}
                                <FormattedDate
                                    date={post.data.pubDate}
                                    locale={locale}
                                />
                            </small>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</Layout>
