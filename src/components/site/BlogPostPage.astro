---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ArticlePage from "../ArticlePage.astro";
import { localizedPath, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
    post: CollectionEntry<"blog">;
}

const { locale, post } = Astro.props;
const { Content, headings } = await render(post);

// Newest first, so the post after this one in the list is the older one.
const posts = (await getCollection("blog"))
    .filter((entry) => entry.data.status === "published")
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const index = posts.findIndex((entry) => entry.id === post.id);
const link = (entry: CollectionEntry<"blog"> | undefined) =>
    entry && {
        title: entry.data.title,
        href: localizedPath(locale, `/blog/${entry.id}/`),
    };
---

<ArticlePage
    locale={locale}
    collection="blog"
    slug={post.id}
    markdown={post.body}
    translationPath={`/blog/${post.id}/`}
    backHref={localizedPath(locale, "/blog/")}
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    heroImage={post.data.heroImage}
    headings={headings}
    previous={link(posts[index + 1])}
    next={index > 0 ? link(posts[index - 1]) : undefined}
>
    <Content />
</ArticlePage>
