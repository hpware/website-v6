---
import { type CollectionEntry, render } from "astro:content";
import { Image } from "astro:assets";
import { CalendarSync, Calendar, ChevronLeft } from "@lucide/astro";
import FormattedDate from "../FormattedDate.astro";
import Link from "../Link.astro";
import Prose from "../Prose.astro";
import Layout from "../../layouts/Default.astro";
import { createTranslator, localizedPath, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
    post: CollectionEntry<"blog">;
}

const { locale, post } = Astro.props;
const T = createTranslator(locale);
const { Content } = await render(post);
const { heroImage, pubDate, updatedDate } = post.data;
---

<Layout
    locale={locale}
    translationPath={`/blog/${post.id}/`}
    title={post.data.title}
    description={post.data.description}
>
    <article class="mx-auto max-w-3xl pb-3">
        <div class="hero-image">
            {
                heroImage && (
                    <Image width={1020} height={510} src={heroImage} alt="" />
                )
            }
        </div>
        <div>
            <div class="mb-1 pb-4">
                <Link
                    href={localizedPath(locale, "/blog/")}
                    class="text-sm text-gray-500 dark:text-gray-400"
                >
                    <ChevronLeft class="h-5 w-5" />{T("返回")}
                </Link>
                <h1 class="text-4xl font-bold">{post.data.title}</h1>
                <div class="mt-2 flex flex-row space-x-2">
                    <div class="flex flex-row items-center space-x-1 text-center">
                        <Calendar class="h-5 w-5" />
                        <FormattedDate date={pubDate} locale={locale} />
                    </div>
                    {
                        updatedDate && (
                            <div class="flex flex-row items-center space-x-1 text-center">
                                <CalendarSync class="h-5 w-5" />
                                <FormattedDate
                                    date={updatedDate}
                                    locale={locale}
                                />
                            </div>
                        )
                    }
                </div>
            </div>
            <hr class="mb-7 border-t border-border" />
            <Prose>
                <Content />
            </Prose>
        </div>
    </article>
</Layout>
