---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Calendar, CalendarSync } from "@lucide/astro";
import ArticlePage from "../ArticlePage.astro";
import FormattedDate from "../FormattedDate.astro";
import { localizedPath, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
    post: CollectionEntry<"blog">;
}

const { locale, post } = Astro.props;
const { Content, headings } = await render(post);

// Newest first, so the post after this one in the list is the older one.
const posts = (await getCollection("blog"))
    .filter((entry) => entry.data.status === "published")
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const index = posts.findIndex((entry) => entry.id === post.id);
const link = (entry: CollectionEntry<"blog"> | undefined) =>
    entry && {
        title: entry.data.title,
        href: localizedPath(locale, `/blog/${entry.id}/`),
    };
---

<ArticlePage
    locale={locale}
    collection="blog"
    slug={post.id}
    markdown={post.body}
    translationPath={`/blog/${post.id}/`}
    backHref={localizedPath(locale, "/blog/")}
    title={post.data.title}
    description={post.data.description}
    heroImage={post.data.heroImage}
    headings={headings}
    previous={link(posts[index + 1])}
    next={index > 0 ? link(posts[index - 1]) : undefined}
>
    <div slot="meta" class="mt-4 flex flex-wrap gap-4 text-sm text-muted-foreground">
        <div class="flex items-center gap-1.5">
            <Calendar class="h-4 w-4" />
            <FormattedDate date={post.data.pubDate} locale={locale} />
        </div>
        {
            post.data.updatedDate && (
                <div class="flex items-center gap-1.5">
                    <CalendarSync class="h-4 w-4" />
                    <FormattedDate date={post.data.updatedDate} locale={locale} />
                </div>
            )
        }
    </div>
    <Content />
</ArticlePage>
