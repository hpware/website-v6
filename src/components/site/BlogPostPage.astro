---
import { type CollectionEntry, render } from "astro:content";
import { Image } from "astro:assets";
import { ArrowLeft } from "@lucide/astro";
import ArticleTranslation from "../ArticleTranslation.astro";
import FormattedDate from "../FormattedDate.astro";
import Prose from "../Prose.astro";
import Layout from "../../layouts/Default.astro";
import { createTranslator, localizedPath, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
    post: CollectionEntry<"blog">;
}

const { locale, post } = Astro.props;
const T = createTranslator(locale);
const { Content } = await render(post);
const { heroImage, pubDate, updatedDate } = post.data;
---

<Layout
    locale={locale}
    translationPath={`/blog/${post.id}/`}
    title={post.data.title}
    description={post.data.description}
>
    <article class="mx-auto max-w-[46rem] pt-6 pb-3 md:pt-12">
        <a
            href={localizedPath(locale, "/blog/")}
            class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
            <ArrowLeft
                class="size-4 transition-transform group-hover:-translate-x-0.5"
                aria-hidden="true"
            />
            {T("部落格")}
        </a>

        <header class="mt-8 border-b border-border pb-8">
            <h1
                data-article-title
                class="display-tight text-4xl leading-[1.1] text-balance sm:text-5xl"
            >
                {post.data.title}
            </h1>
            {
                post.data.description && (
                    <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                        {post.data.description}
                    </p>
                )
            }
            <dl class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs">
                <div class="flex items-center gap-2">
                    <dt class="tape tape-white">{T("發佈於")}</dt>
                    <dd><FormattedDate date={pubDate} locale={locale} /></dd>
                </div>
                {
                    updatedDate && (
                        <div class="flex items-center gap-2">
                            <dt class="tape tape-white">{T("更新於")}</dt>
                            <dd>
                                <FormattedDate
                                    date={updatedDate}
                                    locale={locale}
                                />
                            </dd>
                        </div>
                    )
                }
            </dl>
        </header>

        {
            heroImage && (
                <Image
                    width={1020}
                    height={510}
                    src={heroImage}
                    alt=""
                    class="mt-8 w-full rounded-lg border border-border"
                />
            )
        }

        <div class="mt-10">
            <ArticleTranslation
                locale={locale}
                collection="blog"
                slug={post.id}
                markdown={post.body}
            />
            <Prose data-article-body>
                <Content />
            </Prose>
        </div>
    </article>
</Layout>
