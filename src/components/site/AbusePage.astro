---
import { AtSign } from "@lucide/astro";
import Link from "../Link.astro";
import Layout from "../../layouts/Default.astro";
import { createTranslator, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);
---

<Layout locale={locale} translationPath="/abuse/" title={T("檢舉濫用行為")}>
    <div
        class="absolute inset-0 flex flex-col items-center justify-center space-y-3 text-center"
    >
        <span class="text-6xl">{T("檢舉濫用行為")}</span>
        <div class="mt-1 flex flex-col space-x-2 md:flex-row">
            <Link
                href="mailto:hlabuse@yhw.tw"
                class="group flex flex-row items-center space-x-3"
            >
                <AtSign
                    class="transition-all duration-300 group-hover:-rotate-5 group-hover:scale-110"
                />
                <span class="pl-2">Email</span>
            </Link>
        </div>
    </div>

    <div class="min-h-screen"></div>
</Layout>
