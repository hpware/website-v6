---
import { TriangleAlert } from "@lucide/astro";
import Layout from "../../layouts/Default.astro";
import { createTranslator, localizedPath, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);
---

<Layout locale={locale} translationPath="/404/" title={T("404 找不到頁面")}>
    <div
        class="absolute inset-0 flex flex-col items-center justify-center text-center"
    >
        <TriangleAlert class="h-24 w-24 text-red-600" />
        <h1 class="text-4xl">{T("404 找不到頁面")}</h1>
        <p>{T("抱歉，您要找的頁面不存在。")}</p>
        <p>
            <a
                href={localizedPath(locale, "/")}
                class="underline underline-offset-4"
            >{T("請檢查網址，或返回首頁繼續瀏覽。")}</a>
        </p>
    </div>
</Layout>
