---
import { ArrowLeft } from "@lucide/astro";
import Layout from "../../layouts/Default.astro";
import { createTranslator, localizedPath, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);
---

<Layout locale={locale} translationPath="/404/" title={T("404 找不到頁面")}>
    <div class="mx-auto flex max-w-xl flex-col items-center py-24 text-center">
        <p
            data-rise
            class="font-mono text-8xl font-bold tracking-tighter text-primary sm:text-9xl"
        >
            404
        </p>
        <h1 data-rise style="--i: 1" class="mt-6 text-3xl font-bold">
            {T("404 找不到頁面")}
        </h1>
        <p data-rise style="--i: 2" class="mt-3 text-muted-foreground">
            {T("抱歉，您要找的頁面不存在。")}
        </p>
        <a
            data-rise
            style="--i: 3"
            href={localizedPath(locale, "/")}
            class="group mt-8 inline-flex items-center gap-2 rounded-lg border border-foreground/15 px-5 py-2.5 transition-colors duration-200 hover:bg-foreground/5"
        >
            <ArrowLeft class="size-4 transition-transform duration-200 group-hover:-translate-x-0.5" />
            {T("請檢查網址，或返回首頁繼續瀏覽。")}
        </a>
    </div>
</Layout>
