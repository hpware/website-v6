---
import Layout from "../../layouts/Default.astro";
import { createTranslator, localizedPath, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);
const listUrl = localizedPath(locale, "/slopblock/");
// Opening this with a link appended fills the form and sends the report —
// what the iPhone shortcut below does. `url=` must stay last: the shared link
// is read raw to the end, so an unencoded link with its own & still works.
const shortcutPrefix = `${new URL(localizedPath(locale, "/slopblock/submit"), Astro.site)}?send=1&url=`;
---

<Layout
    locale={locale}
    translationPath="/slopblock/submit"
    title={T("回報 slop 帳號")}
    description={T("把 Instagram 上的 slop 帳號跟影片連結丟過來，審核通過的才會加進封鎖名單。")}
>
    <div class="mx-auto max-w-xl pb-16">
        <h1 class="text-2xl">{T("回報 slop 帳號")}</h1>
        <p class="mt-2 text-sm text-muted-foreground">
            {T("在 Instagram 上看到大量產出 AI 生成垃圾內容（slop）的帳號？把影片連結丟過來；審核通過的帳號會加進")}
            <!-- Link.astro renders a div inside its anchor, which would close
                 this paragraph — use a native anchor here. -->
            <a href={listUrl} class="underline">{T("slop 帳號清單")}</a>
            {T("，沒有通過就不會。")}
        </p>

        <form data-slop-report class="mt-6 flex flex-col gap-4">
            <label class="flex flex-col gap-1 text-sm">
                {T("影片連結")}
                <!-- type=text, not url: "instagram.com/reel/…" without
                     https:// is fine, the server adds it. -->
                <input
                    data-slop-video
                    type="text"
                    inputmode="url"
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                    required
                    placeholder="https://www.instagram.com/reel/…"
                    class="rounded-lg border border-border bg-transparent px-3 py-2 outline-none focus:border-primary"
                />
            </label>
            <label class="flex flex-col gap-1 text-sm">
                <span>
                    {T("Instagram 帳號")}
                    <span class="text-muted-foreground">{T("（選填）")}</span>
                </span>
                <input
                    data-slop-handle
                    type="text"
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                    placeholder={T("使用者名稱或個檔連結")}
                    class="rounded-lg border border-border bg-transparent px-3 py-2 outline-none focus:border-primary"
                />
                <span
                    data-slop-detected
                    data-template={T("從連結偵測到：@{handle}")}
                    class="text-xs text-muted-foreground empty:hidden"
                ></span>
            </label>
            <p class="text-xs text-muted-foreground">
                {T("貼上 slop 影片（例如 reel）的連結就好；帳號會盡量從連結自動判斷，判斷不出來時才需要填。有沒有 @ 都可以。")}
            </p>
            <p class="text-xs text-muted-foreground">
                {T("分享連結裡的追蹤參數（例如 Instagram 的 igsh，會透露是誰分享的）會在送出前自動移除。")}
            </p>
            <button
                type="submit"
                data-slop-submit
                data-busy-label={T("送出中…")}
                class="w-fit rounded-lg bg-primary px-4 py-2 text-sm text-primary-foreground disabled:opacity-60"
            >
                {T("送出")}
            </button>
        </form>

        <!-- Present (and empty) from page load, so assistive tech announces the
             update when the request finishes (WAI-ARIA ARIA22); invisible
             while empty. -->
        <p
            data-slop-status
            data-received={T("已收到 @{handle}！審核通過的帳號才會加進名單，謝謝。")}
            data-duplicate={T("@{handle} 已經有人回報過了。")}
            data-already-listed={T("@{handle} 已經在名單上了。")}
            data-admin-listed={T("已直接把 @{handle} 加進名單（管理員）。")}
            data-error={T("回報失敗，請稍後再試。")}
            role="status"
            class="mt-3 text-sm empty:hidden"
        ></p>

        <section class="mt-10 border-t border-border pt-6">
            <h2 class="text-lg">{T("用 iPhone 捷徑一鍵回報")}</h2>
            <p class="mt-2 text-sm text-muted-foreground">
                {T("做一個捷徑，之後在 Instagram 按「分享」選它，這一頁就會打開並自動送出影片連結。")}
            </p>
            <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm">
                <li>{T("打開「捷徑」App，新增一個捷徑，在詳細資訊裡開啟「在分享表單中顯示」，接收類型選「URL」和「文字」。")}</li>
                <li>{T("加入「URL 編碼」動作，內容選「捷徑輸入」。")}</li>
                <li>
                    {T("加入「打開 URL」動作，貼上下面這串，並在最後面接上「已編碼的 URL」變數：")}
                    <div class="mt-2 flex items-center gap-2">
                        <code
                            data-slop-shortcut-url
                            class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap rounded-lg border border-border px-3 py-2 text-xs"
                        >{shortcutPrefix}</code>
                        <button
                            type="button"
                            data-slop-copy
                            data-copied-label={T("已複製")}
                            class="shrink-0 rounded-lg border border-border px-3 py-2 text-xs"
                        >
                            {T("複製")}
                        </button>
                    </div>
                </li>
                <li>{T("在 Instagram 的 reel 上按「分享」，選這個捷徑就完成了。")}</li>
            </ol>
            <p class="mt-3 text-xs text-muted-foreground">
                {T("不想自動送出的話，把 send=1& 拿掉，頁面只會先幫你填好。其他手機或 App 也可以用同一串網址。")}
            </p>
        </section>
    </div>
</Layout>

<script>
    import { cleanVideoUrl, parseInstagramInput } from "../../lib/slopLinks";

    const form = document.querySelector<HTMLFormElement>("[data-slop-report]");
    if (form) {
        const button = form.querySelector<HTMLButtonElement>("[data-slop-submit]")!;
        const handleInput = form.querySelector<HTMLInputElement>("[data-slop-handle]")!;
        const videoInput = form.querySelector<HTMLInputElement>("[data-slop-video]")!;
        const detected = form.querySelector<HTMLElement>("[data-slop-detected]")!;
        const status = document.querySelector<HTMLElement>("[data-slop-status]")!;
        const fill = (template: string | undefined, handle: string) =>
            (template ?? "").replace("{handle}", handle);

        // Strip share/tracking params as soon as a link lands in the field, so
        // the reporter sees exactly what gets sent.
        const tidyVideo = () => {
            const cleaned = cleanVideoUrl(videoInput.value);
            if (cleaned && cleaned !== videoInput.value.trim()) videoInput.value = cleaned;
        };

        // Shows the account the link names (instagram.com/user/reel/…, a
        // profile link) when the account field is empty.
        const updateDetected = () => {
            const parsed = parseInstagramInput(videoInput.value);
            detected.textContent =
                !handleInput.value.trim() && parsed.kind === "handle"
                    ? fill(detected.dataset.template, parsed.handle)
                    : "";
        };

        // A profile link / @handle pasted in the account field is tidied to
        // the bare username.
        const tidyHandle = () => {
            const parsed = parseInstagramInput(handleInput.value);
            if (parsed.kind === "handle") handleInput.value = parsed.handle;
        };

        videoInput.addEventListener("change", () => {
            tidyVideo();
            updateDetected();
        });
        videoInput.addEventListener("paste", () =>
            setTimeout(() => {
                tidyVideo();
                updateDetected();
            }),
        );
        videoInput.addEventListener("input", updateDetected);
        handleInput.addEventListener("change", () => {
            tidyHandle();
            updateDetected();
        });
        handleInput.addEventListener("input", updateDetected);

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            tidyVideo();
            const submitLabel = button.textContent ?? "";
            button.disabled = true;
            button.textContent = button.dataset.busyLabel ?? submitLabel;
            // Read-only while the report is in flight, so form.reset() can only
            // ever clear the values that were actually submitted.
            handleInput.readOnly = true;
            videoInput.readOnly = true;

            try {
                const response = await fetch("/api/slopblock/report", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        handle: handleInput.value,
                        reason: videoInput.value,
                        locale: document.documentElement.lang,
                    }),
                });
                const result = await response.json().catch(() => ({}));
                // Only an explicit acknowledgment counts — anything else (an
                // HTML error page, an unexpected shape, ...) keeps the draft.
                if (
                    !response.ok ||
                    result.ok !== true ||
                    (result.created !== true &&
                        result.duplicate !== true &&
                        result.alreadyListed !== true)
                ) {
                    throw new Error(
                        typeof result.error === "string" ? result.error : "",
                    );
                }
                const handle = typeof result.handle === "string" ? result.handle : "";
                const template = result.alreadyListed
                    ? status.dataset.alreadyListed
                    : result.duplicate
                      ? status.dataset.duplicate
                      : result.admin
                        ? status.dataset.adminListed
                        : status.dataset.received;
                status.textContent = fill(template, handle);
                status.classList.remove("text-destructive");
                form.reset();
                detected.textContent = "";
            } catch (error) {
                status.textContent =
                    error instanceof Error && error.message
                        ? error.message
                        : (status.dataset.error ?? "");
                status.classList.add("text-destructive");
            } finally {
                handleInput.readOnly = false;
                videoInput.readOnly = false;
                button.disabled = false;
                button.textContent = submitLabel;
            }
        });

        // A link handed over in the address (?url=… from the share-sheet
        // shortcut, or ?text=… with a link inside) fills the form; with
        // send=1 the report goes out straight away. This runs after the
        // submit handler is attached, or requestSubmit() would do a plain GET
        // form submit. The link is read raw to the end of the address, so an
        // unencoded link keeps its own & and ?.
        const shared = location.search.match(/[?&](?:url|text)=(.*)$/)?.[1];
        if (shared) {
            let value = shared;
            try {
                value = decodeURIComponent(shared);
            } catch {
                // A stray % — use the raw text.
            }
            const link = value.match(/https?:\/\/\S+/i)?.[0] ?? value.trim();
            const send = new URLSearchParams(location.search).get("send") === "1";
            // Don't leave the link in the address bar or history.
            history.replaceState(history.state, "", location.pathname);
            videoInput.value = link;
            tidyVideo();
            updateDetected();
            if (send) form.requestSubmit();
            else button.focus();
        }
    }

    const copyButton = document.querySelector<HTMLButtonElement>("[data-slop-copy]");
    const shortcutUrl = document.querySelector<HTMLElement>("[data-slop-shortcut-url]");
    copyButton?.addEventListener("click", async () => {
        const label = copyButton.textContent ?? "";
        try {
            await navigator.clipboard.writeText(shortcutUrl?.textContent?.trim() ?? "");
            copyButton.textContent = copyButton.dataset.copiedLabel ?? label;
            setTimeout(() => (copyButton.textContent = label), 1500);
        } catch {
            // No clipboard access: select the text so it can be copied by hand.
            if (shortcutUrl) getSelection()?.selectAllChildren(shortcutUrl);
        }
    });
</script>
