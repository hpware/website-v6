---
import { Copy, Check } from "lucide-react";
import { createTranslator, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const T = createTranslator(locale);

const sshCommand = "ssh t.yuanhau.com";
---

<div class="mt-6 flex items-center justify-start">
    <button
        type="button"
        data-copy-ssh
        data-command={sshCommand}
        aria-label={T("複製指令")}
        class="group inline-flex items-center gap-3 rounded-lg border border-border/80 bg-muted/30 px-4 py-2.5 font-mono text-sm text-foreground transition-all duration-200 hover:border-foreground/40 hover:bg-muted/60 active:scale-[0.98] cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
    >
        <span class="tracking-wide select-all">{sshCommand}</span>
        <span class="text-muted-foreground transition-colors group-hover:text-foreground">
            <span data-copy-icon-wrapper class="inline-flex items-center">
                <Copy className="size-4" />
            </span>
            <span data-copied-icon-wrapper class="hidden items-center text-emerald-600 dark:text-emerald-400">
                <Check className="size-4" />
            </span>
        </span>
    </button>
</div>

<script>
    const copyButtons = document.querySelectorAll("[data-copy-ssh]");
    copyButtons.forEach((btn) => {
        btn.addEventListener("click", async () => {
            const command = btn.getAttribute("data-command") || "ssh t.yuanhau.com";
            try {
                await navigator.clipboard.writeText(command);
                const copyWrapper = btn.querySelector("[data-copy-icon-wrapper]");
                const copiedWrapper = btn.querySelector("[data-copied-icon-wrapper]");
                if (copyWrapper && copiedWrapper) {
                    copyWrapper.classList.add("hidden");
                    copiedWrapper.classList.remove("hidden");
                    copiedWrapper.classList.add("inline-flex");
                    setTimeout(() => {
                        copyWrapper.classList.remove("hidden");
                        copiedWrapper.classList.add("hidden");
                        copiedWrapper.classList.remove("inline-flex");
                    }, 2000);
                }
            } catch (err) {
                console.error("Failed to copy:", err);
            }
        });
    });
</script>
