---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ArticlePage from "../ArticlePage.astro";
import FormattedDate from "../FormattedDate.astro";
import { createTranslator, localizedPath, type Locale } from "../../i18n";

interface Props {
    locale: Locale;
    post: CollectionEntry<"food">;
}

const { locale, post } = Astro.props;
const T = createTranslator(locale);
const { Content, headings } = await render(post);
const { rating, location, priceRange, pubDate } = post.data;

// Newest first, so the review after this one in the list is the older one.
const reviews = (await getCollection("food"))
    .filter((entry) => entry.data.status === "published")
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const index = reviews.findIndex((entry) => entry.id === post.id);
const link = (entry: CollectionEntry<"food"> | undefined) =>
    entry && {
        title: entry.data.title,
        href: localizedPath(locale, `/food/${entry.id}/`),
    };
---

<ArticlePage
    locale={locale}
    collection="food"
    slug={post.id}
    markdown={post.body}
    translationPath={`/food/${post.id}/`}
    backHref={localizedPath(locale, "/food/")}
    title={post.data.title}
    description={post.data.description}
    heroImage={post.data.heroImage}
    headings={headings}
    previous={link(reviews[index + 1])}
    next={index > 0 ? link(reviews[index - 1]) : undefined}
>
    <dl
        slot="meta"
        class="card-soft mt-5 flex flex-wrap gap-x-12 gap-y-4 px-5 py-4"
    >
        {
            rating !== undefined && (
                <div>
                    <dt class="text-xs text-muted-foreground">{T("評分")}</dt>
                    <dd class="mt-1 text-lg">
                        <span class="text-[#e8761f]">★</span> {rating}{" "}
                        <span class="text-sm text-muted-foreground">/ 5</span>
                    </dd>
                </div>
            )
        }
        {
            location && (
                <div>
                    <dt class="text-xs text-muted-foreground">{T("地點")}</dt>
                    <dd class="mt-1 text-lg">{location}</dd>
                </div>
            )
        }
        {
            priceRange && (
                <div>
                    <dt class="text-xs text-muted-foreground">{T("價位")}</dt>
                    <dd class="mt-1 text-lg">{priceRange}</dd>
                </div>
            )
        }
        <div>
            <dt class="text-xs text-muted-foreground">{T("發佈於")}</dt>
            <dd class="mt-1 text-lg">
                <FormattedDate date={pubDate} locale={locale} />
            </dd>
        </div>
    </dl>
    <Content />
</ArticlePage>
