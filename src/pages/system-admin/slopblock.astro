---
import { Check, X } from "@lucide/astro";
import { api } from "../../../convex/_generated/api";
import type { Id } from "../../../convex/_generated/dataModel";
import Admin from "../../layouts/Admin.astro";
import { convex } from "../../lib/convex";
import { adminSecret, errorMessage, formatDate, text } from "../../lib/admin/utils";
import { setToast } from "../../lib/admin/session";
import { igSlopList, instagramProfileUrl } from "../../lib/slopblock";

let error = "";
if (Astro.request.method === "POST") {
    const form = await Astro.request.formData();
    try {
        const id = text(form, "id") as Id<"slop_reports">;
        const status = text(form, "status");
        if (status !== "listed" && status !== "dismissed") {
            throw new Error("Unknown status.");
        }
        await convex.mutation(api.slopReports.settle, { secret: adminSecret(), id, status });
        setToast(Astro.cookies, `Report marked ${status}.`);
        return Astro.redirect("/system-admin/slopblock", 303);
    } catch (caught) {
        error = errorMessage(caught);
    }
}

const reports = await convex.query(api.slopReports.list, { secret: adminSecret() });
const pending = reports.filter((report) => report.status === "pending");
const reviewed = reports.filter((report) => report.status !== "pending");
---

<Admin title="Slopblock" error={error}>
    <h1 class="text-3xl font-bold">Slopblock</h1>
    <p class="mt-1 text-sm opacity-70">
        Reports from <code>/slopblock/submit</code>. To accept one, add its line to
        <code>src/data/slopblock/ig.txt</code> and deploy, then mark it listed.
    </p>

    <h2 class="mt-8 text-xl font-bold">Pending ({pending.length})</h2>
    <ul class="mt-3 flex flex-col gap-2">
        {
            pending.length === 0 && <li class="admin-hint">No pending reports.</li>
        }
        {
            pending.map((report) => (
                <li class="admin-card p-4">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                        <a
                            href={instagramProfileUrl(report.handle)}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-medium underline"
                        >
                            @{report.handle}
                        </a>
                        <span class="admin-hint">{formatDate(report.created_at)}</span>
                    </div>
                    <p class="mt-1 text-sm">{report.reason}</p>
                    <code class="mt-2 block overflow-x-auto rounded-lg bg-muted px-3 py-2 text-xs whitespace-nowrap">
                        {report.handle} | {report.reason} | {formatDate(report.created_at)}
                    </code>
                    <div class="mt-3 flex gap-2">
                        <form method="post">
                            <input type="hidden" name="id" value={report._id} />
                            <input type="hidden" name="status" value="listed" />
                            <button class="admin-btn admin-btn-primary px-3 py-1.5">
                                <Check class="size-4" aria-hidden="true" /> Listed
                            </button>
                        </form>
                        <form method="post" data-confirm="Dismiss this report?">
                            <input type="hidden" name="id" value={report._id} />
                            <input type="hidden" name="status" value="dismissed" />
                            <button class="admin-btn admin-btn-danger px-3 py-1.5">
                                <X class="size-4" aria-hidden="true" /> Dismiss
                            </button>
                        </form>
                    </div>
                </li>
            ))
        }
    </ul>

    <h2 class="mt-8 text-xl font-bold">Reviewed ({reviewed.length})</h2>
    <ul class="mt-3 flex flex-col gap-2">
        {
            reviewed.length === 0 && <li class="admin-hint">Nothing reviewed yet.</li>
        }
        {
            reviewed.map((report) => (
                <li class="admin-card flex items-center gap-3 py-3">
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium">
                            @{report.handle}
                            <span class="admin-hint ml-2">{report.status}</span>
                        </p>
                        <p class="admin-hint truncate">{report.reason}</p>
                    </div>
                    <span class="admin-hint">{formatDate(report.created_at)}</span>
                </li>
            ))
        }
    </ul>

    <h2 class="mt-8 text-xl font-bold">On the list ({igSlopList.length})</h2>
    <p class="admin-hint mt-1">
        From src/data/slopblock/ig.txt, served at /slopblock/ig.txt.
    </p>
    <ul class="mt-3 flex flex-col gap-2">
        {
            igSlopList.length === 0 && <li class="admin-hint">The list is empty.</li>
        }
        {
            igSlopList.map((entry) => (
                <li class="admin-card flex items-center gap-3 py-3">
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium">@{entry.handle}</p>
                        <p class="admin-hint truncate">{entry.reason}</p>
                    </div>
                    <span class="admin-hint">{entry.added}</span>
                </li>
            ))
        }
    </ul>
</Admin>
