---
import { Check, Plus, Trash2, X } from "@lucide/astro";
import { api } from "../../../convex/_generated/api";
import type { Id } from "../../../convex/_generated/dataModel";
import Admin from "../../layouts/Admin.astro";
import { convex } from "../../lib/convex";
import { adminSecret, errorMessage, formatDate, text } from "../../lib/admin/utils";
import { setToast } from "../../lib/admin/session";
import {
    cleanReason,
    cleanVideoUrl,
    getIgSlopList,
    instagramProfileUrl,
    isHttpUrl,
    isInstagramMediaLink,
    lookupInstagramOwner,
    parseInstagramInput,
} from "../../lib/slopblock";

let error = "";
if (Astro.request.method === "POST") {
    try {
        // Inside the try: an unparseable body uses the page's error path too.
        const form = await Astro.request.formData();
        const action = text(form, "action");
        if (action === "add") {
            // Admin bypass: straight onto the list. The account can be a
            // username, @username or profile link; it can also be left empty
            // when the video link names the account.
            let account = text(form, "account");
            let video = text(form, "video");
            if (isInstagramMediaLink(account) && !video) [account, video] = [video, account];
            const reason = video ? cleanVideoUrl(video) : "";
            if (video && !reason) throw new Error("That video link isn't an http(s) link.");
            let handle = "";
            const parsed = parseInstagramInput(account || reason);
            if (parsed.kind === "handle") handle = parsed.handle;
            else if (!account && parsed.kind === "media") handle = await lookupInstagramOwner(parsed.url);
            if (!handle) {
                throw new Error(
                    account
                        ? "That isn't an Instagram username or profile link."
                        : "Couldn't tell which account posted that video — type the username.",
                );
            }
            const result = await convex.mutation(api.slopReports.addListed, {
                secret: adminSecret(),
                handle,
                reason,
            });
            setToast(
                Astro.cookies,
                result.alreadyListed ? `@${handle} is already listed.` : `Listed @${handle}.`,
            );
        } else if (action === "unlist") {
            const handle = text(form, "handle");
            await convex.mutation(api.slopReports.unlist, { secret: adminSecret(), handle });
            setToast(Astro.cookies, `Removed @${handle} from the list.`);
        } else {
            const id = text(form, "id") as Id<"slop_reports">;
            const status = text(form, "status");
            if (status !== "listed" && status !== "dismissed") {
                throw new Error("Unknown status.");
            }
            await convex.mutation(api.slopReports.settle, { secret: adminSecret(), id, status });
            setToast(Astro.cookies, status === "listed" ? "Listed — it's live." : "Report dismissed.");
        }
        return Astro.redirect("/system-admin/slopblock", 303);
    } catch (caught) {
        error = errorMessage(caught);
    }
}

const [reports, list] = await Promise.all([
    convex.query(api.slopReports.list, { secret: adminSecret() }),
    getIgSlopList(),
]);
const igSlopList = [...list.entries].reverse();
const pending = reports.filter((report) => report.status === "pending");
const reviewed = reports.filter((report) => report.status !== "pending");
---

<Admin title="Slopblock" error={error}>
    <h1 class="text-3xl font-bold">Slopblock</h1>
    <p class="mt-1 text-sm opacity-70">
        Reports from <code>/slopblock/submit</code>. <strong>List</strong> puts an
        account on <code>/slopblock/</code> and <code>/slopblock/ig.txt</code> right
        away — no deploy. While signed in, the public submit form lists directly too.
    </p>

    <h2 class="mt-8 text-xl font-bold">Add an account</h2>
    <form method="post" class="admin-card mt-3 flex flex-col gap-3 p-4">
        <input type="hidden" name="action" value="add" />
        <label class="flex flex-col gap-1 text-sm">
            Account
            <input
                name="account"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="username, @username or profile link"
                class="admin-input"
            />
        </label>
        <label class="flex flex-col gap-1 text-sm">
            Video link <span class="admin-hint">(optional; fills in the account if left empty)</span>
            <input
                name="video"
                inputmode="url"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="https://www.instagram.com/reel/…"
                class="admin-input"
            />
        </label>
        <button class="admin-btn admin-btn-primary w-fit px-3 py-1.5">
            <Plus class="size-4" aria-hidden="true" /> List now
        </button>
    </form>

    <h2 class="mt-8 text-xl font-bold">Pending ({pending.length})</h2>
    <ul class="mt-3 flex flex-col gap-2">
        {
            pending.length === 0 && <li class="admin-hint">No pending reports.</li>
        }
        {
            pending.map((report) => (
                <li class="admin-card p-4">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                        <a
                            href={instagramProfileUrl(report.handle)}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-medium underline"
                        >
                            @{report.handle}
                        </a>
                        <span class="admin-hint">{formatDate(report.created_at)}</span>
                    </div>
                    <!-- The reason is a video link — make it clickable to
                         review the slop clip. -->
                    {isHttpUrl(report.reason) ? (
                        <a
                            href={cleanReason(report.reason)}
                            target="_blank"
                            rel="noopener noreferrer"
                            title={cleanReason(report.reason)}
                            class="mt-1 block truncate text-sm underline"
                        >
                            {cleanReason(report.reason)}
                        </a>
                    ) : (
                        <p class="mt-1 text-sm">{report.reason}</p>
                    )}
                    <div class="mt-3 flex gap-2">
                        <form method="post">
                            <input type="hidden" name="id" value={report._id} />
                            <input type="hidden" name="status" value="listed" />
                            <button class="admin-btn admin-btn-primary px-3 py-1.5">
                                <Check class="size-4" aria-hidden="true" /> List
                            </button>
                        </form>
                        <form method="post" data-confirm="Dismiss this report?">
                            <input type="hidden" name="id" value={report._id} />
                            <input type="hidden" name="status" value="dismissed" />
                            <button class="admin-btn admin-btn-danger px-3 py-1.5">
                                <X class="size-4" aria-hidden="true" /> Dismiss
                            </button>
                        </form>
                    </div>
                </li>
            ))
        }
    </ul>

    <h2 class="mt-8 text-xl font-bold">Reviewed ({reviewed.length})</h2>
    <ul class="mt-3 flex flex-col gap-2">
        {
            reviewed.length === 0 && <li class="admin-hint">Nothing reviewed yet.</li>
        }
        {
            reviewed.map((report) => (
                <li class="admin-card flex items-center gap-3 py-3">
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium">
                            @{report.handle}
                            <span class="admin-hint ml-2">{report.status}</span>
                        </p>
                        <p class="admin-hint truncate">{cleanReason(report.reason)}</p>
                    </div>
                    <span class="admin-hint">
                        {report.status === "listed" && report.listed_at
                            ? formatDate(report.listed_at)
                            : formatDate(report.created_at)}
                    </span>
                </li>
            ))
        }
    </ul>

    <h2 class="mt-8 text-xl font-bold">On the list ({igSlopList.length})</h2>
    <p class="admin-hint mt-1">
        Served at /slopblock/ig.txt. Newest first.
        {!list.ok && " Convex is unreachable — only src/data/slopblock/ig.txt lines are shown."}
    </p>
    <ul class="mt-3 flex flex-col gap-2">
        {
            igSlopList.length === 0 && <li class="admin-hint">The list is empty.</li>
        }
        {
            igSlopList.map((entry) => (
                <li class="admin-card flex items-center gap-3 py-3">
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium">
                            <a
                                href={instagramProfileUrl(entry.handle)}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="underline"
                            >
                                @{entry.handle}
                            </a>
                            {entry.listedAt !== undefined && (
                                <span class="admin-hint ml-2">{formatDate(entry.listedAt)}</span>
                            )}
                        </p>
                        <p class="admin-hint truncate">{entry.reason}</p>
                    </div>
                    {entry.source === "convex" ? (
                        <form method="post" data-confirm={`Remove @${entry.handle} from the list?`}>
                            <input type="hidden" name="action" value="unlist" />
                            <input type="hidden" name="handle" value={entry.handle} />
                            <button class="admin-btn admin-btn-danger px-3 py-1.5" aria-label={`Remove @${entry.handle}`}>
                                <Trash2 class="size-4" aria-hidden="true" />
                            </button>
                        </form>
                    ) : (
                        <span class="admin-hint">in ig.txt</span>
                    )}
                </li>
            ))
        }
    </ul>
</Admin>
