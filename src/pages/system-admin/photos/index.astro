---
import { Plus } from "@lucide/astro";
import { api } from "../../../../convex/_generated/api";
import StatusBadge from "../../../components/admin/StatusBadge.astro";
import Admin from "../../../layouts/Admin.astro";
import { convex } from "../../../lib/convex";
import { coverUrl } from "../../../lib/photoUrl";

const packs = await Promise.all(
    (await convex.query(api.galleries.listWithCovers, {})).map(async (pack) => ({
        ...pack,
        coverSrc: pack.cover && (await coverUrl(pack.cover, 600)),
    })),
);
---

<Admin title="Photos">
    <div class="flex items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold">Photo packs</h1>
            <p class="mt-1 text-sm opacity-70">Published packs with photos show up at /photos/.</p>
        </div>
        <a href="/system-admin/photos/new" class="admin-btn admin-btn-primary">
            <Plus class="size-4" aria-hidden="true" /> New photo pack
        </a>
    </div>

    {packs.length === 0 && <p class="admin-hint mt-6">No photo packs yet.</p>}
    <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {
            packs.map((pack) => (
                <li>
                    <a href={`/system-admin/photos/${pack.slug}`} class="block">
                        <div class="aspect-square overflow-hidden rounded-2xl bg-gray-500/20 shadow-md">
                            {pack.coverSrc && (
                                <img
                                    src={pack.coverSrc}
                                    alt=""
                                    loading="lazy"
                                    class="size-full object-cover"
                                />
                            )}
                        </div>
                        <div class="mt-2 flex items-center justify-between gap-2">
                            <span class="truncate font-medium">{pack.name}</span>
                            <StatusBadge status={pack.status} />
                        </div>
                    </a>
                </li>
            ))
        }
    </ul>
</Admin>
