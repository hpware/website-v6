---
import Layout from "../layouts/Default.astro";
import Link from "../components/Link.astro";
import contributionData from "../data/contributions.json";

interface ContributionLink {
    label: string;
    url: string;
}

interface ContributionItem {
    slug: string;
    title: string;
    description: string;
    isUnmaintained: boolean;
    categories: string[];
    links: ContributionLink[];
}

interface ContributionSection {
    id: string;
    title: string;
    description: string | null;
    items: ContributionItem[];
}

const sections = contributionData as ContributionSection[];
---

<Layout
    title="Contributions"
    description="Projects, security research, bug findings, and other contributions by Howard."
>
    <div class="mx-auto max-w-3xl">
        <h1 class="text-2xl">Contributions</h1>
        <p class="mt-2 text-sm text-muted-foreground">
            Projects, research, bug findings, and other things I have worked on.
        </p>

        {
            sections.map((section) => (
                <section id={section.id} class="mt-10">
                    <h2 class="text-xl">{section.title}</h2>
                    {section.description && (
                        <p class="mt-1 text-sm text-muted-foreground">
                            {section.description}
                        </p>
                    )}

                    <ul class="mt-4 flex flex-col gap-4">
                        {section.items.map((item) => (
                            <li
                                id={item.slug}
                                class="rounded-lg border border-accent p-4"
                            >
                                <div class="flex flex-wrap items-start justify-between gap-2">
                                    <h3 class="text-xl">{item.title}</h3>
                                    <span class="text-xs text-muted-foreground">
                                        {item.categories.join(" · ")}
                                        {item.isUnmaintained && " · Unmaintained"}
                                    </span>
                                </div>

                                <p class="mt-2 text-sm leading-6 text-muted-foreground">
                                    {item.description}
                                </p>

                                {item.links.length > 0 && (
                                    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
                                        {item.links.map((link) => (
                                            <Link href={link.url}>{link.label}</Link>
                                        ))}
                                    </div>
                                )}
                            </li>
                        ))}
                    </ul>
                </section>
            ))
        }
    </div>
</Layout>
