---
import { getEntry } from "astro:content";
import FoodPostPage from "../../../components/site/FoodPostPage.astro";
const post = Astro.params.slug
    ? await getEntry("food", Astro.params.slug)
    : undefined;

if (!post || post.data.status !== "published") {
    return Astro.rewrite("/en/404");
}
---

<FoodPostPage locale="en" post={post} />
