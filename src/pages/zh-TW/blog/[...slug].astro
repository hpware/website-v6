---
import { getEntry } from "astro:content";
import BlogPostPage from "../../../components/site/BlogPostPage.astro";
const post = Astro.params.slug
    ? await getEntry("blog", Astro.params.slug)
    : undefined;

if (!post || post.data.status !== "published") {
    return Astro.rewrite("/zh-TW/404");
}
---

<BlogPostPage locale="zh-TW" post={post} />
